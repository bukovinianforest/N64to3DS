+		// Chunks spanned by [rom_offset, rom_offset + request_bytes)
+		u32		max_chunks( 1 );
+		if( request_bytes > 1 )
+		{
+			const u64	last( u64( rom_offset ) + request_bytes - 1 );
+			max_chunks = u32( std::min< u64 >( last / CHUNK_SIZE - chunk_map_idx + 1, MAX_RUN_BYTES / CHUNK_SIZE ) );
+		}
+		CacheIdx	idx( GetCacheIndex( rom_offset, max_chunks ) );
 		#ifdef DAEDALUS_ENABLE_ASSERTS
 		DAEDALUS_ASSERT( idx < CACHE_SIZE, "Invalid chunk index!" );
 		#endif
