+// n64to3ds: the largest block malloc can hand out now (256 KB resolution),
+// to log how much memory a game leaves free.
+static u32 LargestFreeBlockKB()
+{
+	u32 low = 0, high = 128 * 1024;	// KB
+	while (high - low > 256)
+	{
+		const u32 middle = (low + high) / 2;
+		// volatile: GCC may delete a malloc/free pair whose block is unused.
+		void * volatile block = malloc(size_t(middle) * 1024);
+		if (block != nullptr)
+		{
+			free(block);
+			low = middle;
+		}
+		else
+		{
+			high = middle;
+		}
+	}
+	return low;
+}
