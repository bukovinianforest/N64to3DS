diff --git a/Source/HLEAudio/AdpcmFast.h b/Source/HLEAudio/AdpcmFast.h
new file mode 100644
index 0000000..13863c3
--- /dev/null
+++ b/Source/HLEAudio/AdpcmFast.h
@@ -0,0 +1,91 @@
+#pragma once
+
+// n64to3ds: the ADPCM predictor of the three audio ABIs (DecodeSamples in
+// HLEAudioState.cpp, ADPCM2_Loop and ADPCM3 in ABI_ADPCM.cpp), the costliest
+// audio command after the envelope mixers on an Old 3DS.
+//
+// For one group of 8 samples the originals compute, with 32-bit wrapping sums,
+//   a[k] = book1[k] * l1 + book2[k] * l2 + sum(j < k) book2[k-1-j] * in[j] + in[k] * 2048
+// and store Saturate<s16>(a[k] >> 11) at out[k ^ 1]; l1 and l2 become the
+// stored a[6] and a[7].  Every factor is a 16-bit value (the codebooks, the
+// previous samples and the scaled nibbles), so the 44 32-bit multiplies can
+// be ARMv6 16-bit multiply-accumulates on packed halfword pairs (SMLAxy,
+// SMLADX), which cost half as much on the ARM11.  The sums are the same
+// modulo 2^32, so the output is bit-identical; the host build uses exact
+// scalar equivalents of the instructions, and tests/test_audio_hle.py
+// compares it with the original code of each ABI.  Defining
+// N64TO3DS_AUDIO_REFERENCE builds the original code instead.
+
+#include "Base/Types.h"
+
+namespace n64to3ds_audio
+{
+
+#if defined(__arm__) && defined(__ARM_ARCH) && __ARM_ARCH >= 6
+#define N64TO3DS_ADP_OP(name, insn)																\
+	inline s32 name(u32 a, u32 b, s32 acc)															\
+	{ s32 r; asm(insn " %0, %1, %2, %3" : "=r"(r) : "r"(a), "r"(b), "r"(acc)); return r; }
+N64TO3DS_ADP_OP(AdpSmlabb, "smlabb")	// a.lo * b.lo + acc
+N64TO3DS_ADP_OP(AdpSmlabt, "smlabt")	// a.lo * b.hi + acc
+N64TO3DS_ADP_OP(AdpSmlatb, "smlatb")	// a.hi * b.lo + acc
+N64TO3DS_ADP_OP(AdpSmlatt, "smlatt")	// a.hi * b.hi + acc
+N64TO3DS_ADP_OP(AdpSmladx, "smladx")	// a.lo * b.hi + a.hi * b.lo + acc
+#undef N64TO3DS_ADP_OP
+inline s32 AdpSat16(s32 x) { s32 r; asm("ssat %0, #16, %1" : "=r"(r) : "r"(x)); return r; }
+#else
+inline s32 AdpLo(u32 a) { return (s16)a; }
+inline s32 AdpHi(u32 a) { return (s16)(a >> 16); }
+inline s32 AdpAdd(s32 acc, s64 p) { return (s32)(u32)((u64)(u32)acc + (u64)p); }
+inline s32 AdpSmlabb(u32 a, u32 b, s32 acc) { return AdpAdd(acc, (s64)AdpLo(a) * AdpLo(b)); }
+inline s32 AdpSmlabt(u32 a, u32 b, s32 acc) { return AdpAdd(acc, (s64)AdpLo(a) * AdpHi(b)); }
+inline s32 AdpSmlatb(u32 a, u32 b, s32 acc) { return AdpAdd(acc, (s64)AdpHi(a) * AdpLo(b)); }
+inline s32 AdpSmlatt(u32 a, u32 b, s32 acc) { return AdpAdd(acc, (s64)AdpHi(a) * AdpHi(b)); }
+inline s32 AdpSmladx(u32 a, u32 b, s32 acc) { return AdpAdd(AdpAdd(acc, (s64)AdpLo(a) * AdpHi(b)), (s64)AdpHi(a) * AdpLo(b)); }
+inline s32 AdpSat16(s32 x) { return x > 32767 ? 32767 : (x < -32768 ? -32768 : x); }
+#endif
+
+inline u32 AdpPack(s32 lo, s32 hi) { return (u16)lo | ((u32)(u16)hi << 16); }
+
+// See the comment at the top.  `in` holds 16-bit values in 32-bit slots
+// (int in ABI2, s32 elsewhere; they differ on the ARM toolchain).
+template <typename Sample>
+inline void AdpcmPredict8(s16 * out, s32 & l1, s32 & l2, const Sample * in, const s16 * book1, const s16 * book2)
+{
+	// b1[i] = book1[2i] | book1[2i+1] << 16, likewise v[i] for book2 (packed
+	// from halfwords: the books are only known to be 2-byte aligned).
+	const u32 b1[4] = { AdpPack(book1[0], book1[1]), AdpPack(book1[2], book1[3]),
+						AdpPack(book1[4], book1[5]), AdpPack(book1[6], book1[7]) };
+	const u32 v[4] = { AdpPack(book2[0], book2[1]), AdpPack(book2[2], book2[3]),
+					   AdpPack(book2[4], book2[5]), AdpPack(book2[6], book2[7]) };
+	const u32 L = AdpPack(l1, l2);
+	const u32 i01 = AdpPack(in[0], in[1]), i12 = AdpPack(in[1], in[2]), i23 = AdpPack(in[2], in[3]);
+	const u32 i34 = AdpPack(in[3], in[4]), i45 = AdpPack(in[4], in[5]), i56 = AdpPack(in[5], in[6]);
+
+	// Even k: book1[k], book2[k] are the low halves of b1[k/2], v[k/2]; odd k
+	// the high halves.  The book2 * in pairs use SMLADX with input pairs that
+	// start at an even j for even k and at an odd j for odd k, so that the
+	// coefficients are a whole word v[m/2]; odd k leave in[0] * book2[k-1].
+	s32 a[8];
+	a[0] = AdpSmlabt(v[0], L, AdpSmlabb(b1[0], L, in[0] * 2048));
+	a[1] = AdpSmlabb(i01, v[0], AdpSmlatt(v[0], L, AdpSmlatb(b1[0], L, in[1] * 2048)));
+	a[2] = AdpSmladx(i01, v[0], AdpSmlabt(v[1], L, AdpSmlabb(b1[1], L, in[2] * 2048)));
+	a[3] = AdpSmlabb(i01, v[1], AdpSmladx(i12, v[0], AdpSmlatt(v[1], L, AdpSmlatb(b1[1], L, in[3] * 2048))));
+	a[4] = AdpSmladx(i23, v[0], AdpSmladx(i01, v[1], AdpSmlabt(v[2], L, AdpSmlabb(b1[2], L, in[4] * 2048))));
+	a[5] = AdpSmlabb(i01, v[2], AdpSmladx(i34, v[0], AdpSmladx(i12, v[1],
+		   AdpSmlatt(v[2], L, AdpSmlatb(b1[2], L, in[5] * 2048)))));
+	a[6] = AdpSmladx(i45, v[0], AdpSmladx(i23, v[1], AdpSmladx(i01, v[2],
+		   AdpSmlabt(v[3], L, AdpSmlabb(b1[3], L, in[6] * 2048)))));
+	a[7] = AdpSmlabb(i01, v[3], AdpSmladx(i56, v[0], AdpSmladx(i34, v[1], AdpSmladx(i12, v[2],
+		   AdpSmlatt(v[3], L, AdpSmlatb(b1[3], L, in[7] * 2048))))));
+
+	out[0] = (s16)AdpSat16(a[1] >> 11);
+	out[1] = (s16)AdpSat16(a[0] >> 11);
+	out[2] = (s16)AdpSat16(a[3] >> 11);
+	out[3] = (s16)AdpSat16(a[2] >> 11);
+	out[4] = (s16)AdpSat16(a[5] >> 11);
+	out[5] = (s16)AdpSat16(a[4] >> 11);
+	out[6] = (s16)(l2 = AdpSat16(a[7] >> 11));
+	out[7] = (s16)(l1 = AdpSat16(a[6] >> 11));
+}
+
+}	// namespace n64to3ds_audio
