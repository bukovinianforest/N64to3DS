+				double(gN64GfxTaskMaxTicks) * tick_ms, (unsigned long)gCPUState.CurrentPC);
+			std::cout << line << std::endl;
+			now = svcGetSystemTick();	// the SD write is not part of the next frame
+		}
+	}
+	last = now;
+	last_vi = vi;
+	last_compiles = gN64FragmentCompiles;
+	last_resets = gN64FragmentResets;
+	last_flushes = gN64CodeFlushes;
+	last_interp = gN64InterpOps;
+	last_textures = gN64TextureUpdates;
+	last_texels = gN64TextureTexels;
+	last_gfx_wait = gGfxWaitTicks;
+	last_audio_wait = gAudioWaitTicks;
+	gN64GfxTaskMaxTicks = 0;
+}
