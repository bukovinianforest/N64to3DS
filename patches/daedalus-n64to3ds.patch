+	std::error_code ec;
+	std::filesystem::rename( temp_path, path, ec );
+	if( ec )
+	{
+		// Some FAT backends refuse to overwrite an existing name.
+		std::error_code remove_ec;
+		std::filesystem::remove( path, remove_ec );
+		ec.clear();
+		std::filesystem::rename( temp_path, path, ec );
+	}
