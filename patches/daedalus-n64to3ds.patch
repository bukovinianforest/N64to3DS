+		static u32 empty_origin = 0;
+		static u32 empty_origin_changes = 0;
+		if (gCTRDrawsSinceSwap == 0)
+		{
+			if (current_origin != empty_origin)
+			{
+				empty_origin = current_origin;
+				++empty_origin_changes;
+			}
+			if (empty_origin_changes < 3)
+				return;
+		}
+		empty_origin = 0;
+		empty_origin_changes = 0;
+		gCTRDrawsSinceSwap = 0;
+
