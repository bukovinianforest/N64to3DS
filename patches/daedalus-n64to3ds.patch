+namespace {
+// n64to3ds: ARM11-friendly ENVMIXER3 inner loop.
+//
+// The original loop visits sample index y ^ 1 for y = 0..183, so samples come
+// in pairs that share one 32-bit word of each buffer: y = 2k uses the high
+// halfword of word k and y = 2k + 1 the low halfword (little-endian host).
+// Every word is therefore read and written once instead of each halfword
+// separately, all five buffers are addressed from one pointer with constant
+// offsets, the ramp direction is a template parameter instead of a per-sample
+// branch, and saturation is a single SSAT.  The arithmetic and its order are
+// unchanged, so the output is bit-identical (checked against the original
+// loop on random inputs).
+struct EnvRamp3 {
+  s32 adder, acc, vol, trg;
+};
+
+inline s32 SaturateS16Fast(s32 x) {
+#if defined(__arm__) && defined(__ARM_ARCH) && __ARM_ARCH >= 6
+  s32 r;
+  asm("ssat %0, #16, %1" : "=r"(r) : "r"(x));
+  return r;
+#else
+  return Saturate<s16>(x);
+#endif
+}
+
+template <bool Up> inline void EnvStep3(EnvRamp3 &r) {
+  r.acc += r.adder;
+  r.vol += (r.acc >> 16);
+  r.acc &= 0xFFFF;
+  if (Up) {
+    if (r.vol > r.trg) r.vol = r.trg;
+  } else {
+    if (r.vol < r.trg) r.vol = r.trg;
+  }
+}
+
+// True when every later EnvStep3 leaves vol at trg: acc is a 16-bit fraction
+// and the adder moves vol only towards and past the target, where the clamp
+// stops it.  The bound on an upward adder keeps acc + adder from overflowing.
+template <bool Up> inline bool EnvSettled3(const EnvRamp3 &r) {
+  if (r.acc < 0 || r.acc > 0xFFFF) return false;
+  return Up ? (r.adder >= 0 && r.adder <= 0x7FFF0000 && r.vol >= r.trg)
+            : (r.adder <= 0 && r.vol <= r.trg);
+}
+
+// The state after `steps` settled EnvStep3 calls: each step adds adder and
+// keeps the low 16 bits, so only the sum modulo 2^16 matters.
+inline void EnvSkip3(EnvRamp3 &r, u32 steps) {
+  r.acc = (s32)(((u32)r.acc + steps * (u32)r.adder) & 0xFFFF);
+  r.vol = r.trg;
+}
+
+inline u32 LoadWord(const u8 *p) { u32 v; memcpy(&v, p, 4); return v; }
+inline void StoreWord(u8 *p, u32 v) { memcpy(p, &v, 4); }
+inline s32 Mix3(s32 acc, s32 in, s32 gain) { return SaturateS16Fast(acc + (((in * gain) + 0x4000) >> 15)); }
+
+template <bool LUp, bool RUp>
+void EnvMixer3Pairs(u8 *buffer, s32 Dry, s32 Wet, EnvRamp3 &l, EnvRamp3 &r) {
+  constexpr u32 kIn = 0x4F0, kOut = 0x9D0, kAux1 = 0xB40, kAux2 = 0xCB0, kAux3 = 0xE20;
+  u32 offset = 0;
