diff --git a/Source/SysCTR/HLEGraphics/GraphicsThreadCTR.cpp b/Source/SysCTR/HLEGraphics/GraphicsThreadCTR.cpp
new file mode 100644
index 0000000..ff0a0a7
--- /dev/null
+++ b/Source/SysCTR/HLEGraphics/GraphicsThreadCTR.cpp
@@ -0,0 +1,469 @@
+// n64to3ds: HLE display-list rendering on core 1; see GraphicsThreadCTR.h.
+
+#include "Base/Types.h"
+#include "SysCTR/HLEGraphics/GraphicsThreadCTR.h"
+
+#include <3ds.h>
+#include <algorithm>
+#include <cstdlib>
+#include <cstring>
+#include <iostream>
+
+#include "Core/CPU.h"
+#include "Core/Memory.h"
+#include "OSHLE/OSTask.h"
+#include "HLEGraphics/DLParser.h"
+#include "HLEGraphics/GraphicsPlugin.h"
+#include "Ultra/ultra_rcp.h"
+#include "SysCTR/Utility/MemoryCTR.h"
+
+void RSP_HLE_Finished(u32 setbits);	// Core/RSP_HLE.cpp
+extern void HandleEndOfFrame();		// SysCTR/main.cpp
+
+namespace
+{
+// The guest sees the task finish no earlier than this many COUNT cycles after
+// it started, and is checked again every GRAPHICS_POLL_CYCLES while the
+// thread is busy.  After GRAPHICS_MAX_DEFER_CYCLES (about three NTSC VIs)
+// the CPU thread blocks, which bounds how late the guest sees the task end.
+// A guest waiting for the task idles, and emulated time passes quickly; with
+// a cap of one VI core 0 blocked 4-5 ms per VI on the console.  Letting VIs
+// (and the guest's audio, which runs on them) continue while core 1 renders
+// is like a slow RDP on the N64.
+const u32 GRAPHICS_FIRST_POLL_CYCLES = 20000;
+const u32 GRAPHICS_POLL_CYCLES       = 20000;
+const u32 GRAPHICS_MAX_DEFER_CYCLES  = 2400000;
+
+// Pacing the guest's frames for its audio.  A game such as HM64 builds a new
+// frame whenever its graphics tasks have finished, and building frames costs
+// core 0 most of the time it needs to keep up 60 VI/s, which the game's audio
+// runs on (console JITPROF run: map tile rendering ~34% of core 0, and fewer
+// VI/s whenever the game drew more frames).  When the audio ring runs low,
+// the full-sync (DP) interrupt of each task is raised some cycles after the
+// task finished, like a slower RDP: the game sees its frames end later and
+// draws fewer of them, while the SP is free at once, so audio tasks are not
+// delayed.  The delay grows while the ring is low and shrinks again once it
+// is well filled.
+//
+// Off (DP_DELAY_MAX_CYCLES 0): on the console the pacing cut underruns in
+// HM64's music scenes from 461 to 168 per minute but held the game at 8
+// presents/s instead of 16, which the owner found worse than the stutter.
+// 800000 (about one NTSC VI) is the measured setting.
+const u32 DP_DELAY_STEP_UP      = 25000;
+const u32 DP_DELAY_STEP_DOWN    = 10000;
+const u32 DP_DELAY_MAX_CYCLES   = 0;
+// Of the 8192-sample ring (186 ms at 44.1 kHz).
+const u32 AUDIO_LOW_SAMPLES     = 4096;
+const u32 AUDIO_HIGH_SAMPLES    = 6144;
+
+// Below the audio thread (0x18): audio has a deadline, rendering only delays
+// the guest.
+const s32 GRAPHICS_THREAD_PRIORITY   = 0x19;
+const size_t GRAPHICS_THREAD_STACK   = 256 * 1024;
+
+Thread			sThread = nullptr;
+bool			sTriedCreate = false;
+volatile bool	sRun = false;
+volatile bool	sBusy = false;
+// From StartTask until CompleteTask, on the CPU thread.
+bool			sTaskInFlight = false;
+Handle			sRequest = 0;
+Handle			sDone = 0;
+u32				sThreadId = 0;
+u32				sDeferredCycles = 0;
+u32				sDpDelayCycles = 0;
+// A full-sync interrupt waits for CPU_EVENT_GRAPHICS_DP.
+bool			sDpPending = false;
+// The guest was told the SP task finished before core 1 did (see
+// GraphicsThreadCTR_ReleaseSP).
+bool			sSpReleased = false;
+// Written by the graphics thread while it renders, read by the CPU thread
+// after it has seen sBusy == false.
+volatile bool	sFullSyncPending = false;
+volatile bool	sEndOfFramePending = false;
+
+// RDRAM read by the rendering task (slot sRangeSlot) and the previous tasks,
+// each tagged with its root display list address.  Only the graphics thread
+// appends; the CPU thread reads the slots while the thread is idle.
+const u32 kRangeSlots = 8;
+const u32 kMaxRanges  = 2048;
+struct RdramRange { u32 begin, end; };
+RdramRange		sRanges[kRangeSlots][kMaxRanges];
+u32				sRangeCount[kRangeSlots] = {};
+u32				sRangeTag[kRangeSlots] = {};
+u32				sRangeSlot = 0;
+// Reads of one kind that follow each other are merged before they are
+// stored (display lists are read 8 bytes at a time).
+RdramRange		sReadRun[GFX_READ_KINDS];
+bool			sReadRunValid[GFX_READ_KINDS] = {};
+const u32		kRunGap = 256;
+// The guest builds a frame at slightly different offsets each time (more
+// sprites, a longer display list): copy the gaps between nearby ranges and
+// a little past each one as well.
+const u32		kSnapshotGap  = 4096;
+const u32		kSnapshotTail = 1024;
+
+// Snapshot of the predicted ranges, merged and sorted, built at task start.
+const u32 kSnapshotBytes = 1024 * 1024;
+struct SnapshotRange { u32 begin, end, offset; };
+u8 *			sSnapshot = nullptr;
+SnapshotRange	sSnapshotRanges[kRangeSlots * kMaxRanges];
+u32				sSnapshotCount = 0;
+u32				sSnapshotHit[GFX_READ_KINDS] = {};	// last range used, per kind
+RdramRange		sMergeScratch[kRangeSlots * kMaxRanges];
+u32				sSnapshotBytesCopied = 0;
+u32				sSnapshotMisses[GFX_READ_KINDS] = {};
+// From StartTask until the CPU thread has seen the task finish.
+volatile bool	sRendering = false;
+
+void StoreRange(u32 begin, u32 end)
+{
+	const u32 slot = sRangeSlot;
+	if (sRangeCount[slot] < kMaxRanges)
+	{
+		sRanges[slot][sRangeCount[slot]].begin = begin;
+		sRanges[slot][sRangeCount[slot]].end = end;
+		++sRangeCount[slot];
+	}
+}
+
+void FlushRuns()	// graphics thread, end of the task
+{
+	for (u32 k = 0; k < GFX_READ_KINDS; ++k)
+	{
+		if (sReadRunValid[k])
+			StoreRange(sReadRun[k].begin, sReadRun[k].end);
+		sReadRunValid[k] = false;
+	}
+}
+
+// CPU thread, graphics thread idle: copy what the previous tasks with this
+// root display list read (all slots when there are none).
+void BuildSnapshot(u32 root)
+{
+	sSnapshotCount = 0;
+	for (u32 k = 0; k < GFX_READ_KINDS; ++k)
+		sSnapshotHit[k] = 0;
+	if (sSnapshot == nullptr)
+	{
+		sSnapshot = static_cast<u8 *>(malloc(kSnapshotBytes));
+		if (sSnapshot == nullptr)
+			return;
+	}
+	bool tagged = false;
+	for (u32 slot = 0; slot < kRangeSlots; ++slot)
+		if (slot != sRangeSlot && sRangeCount[slot] != 0 && sRangeTag[slot] == root)
+			tagged = true;
+	u32 n = 0;
+	for (u32 slot = 0; slot < kRangeSlots; ++slot)
+	{
+		if (slot == sRangeSlot || (tagged && sRangeTag[slot] != root))
+			continue;
+		for (u32 i = 0; i < sRangeCount[slot]; ++i)
+			sMergeScratch[n++] = sRanges[slot][i];
+	}
+	std::sort(sMergeScratch, sMergeScratch + n, [](const RdramRange & a, const RdramRange & b) { return a.begin < b.begin; });
+	u32 used = 0;
+	for (u32 i = 0; i < n; )
+	{
+		u32 begin = sMergeScratch[i].begin;
+		u32 end = sMergeScratch[i].end + kSnapshotTail;
+		for (++i; i < n && sMergeScratch[i].begin <= end + kSnapshotGap; ++i)
+			end = std::max(end, sMergeScratch[i].end + kSnapshotTail);
+		if (end > gRamSize)
+			end = gRamSize;
+		if (begin >= end)
+			continue;
+		// Same alignment as in RDRAM: the readers load words.
+		used += (begin - used) & 7;
+		if (used + (end - begin) > kSnapshotBytes)
+			break;	// the rest is read from RDRAM
+		memcpy(sSnapshot + used, g_pu8RamBase + begin, end - begin);
+		sSnapshotRanges[sSnapshotCount].begin = begin;
+		sSnapshotRanges[sSnapshotCount].end = end;
+		sSnapshotRanges[sSnapshotCount].offset = used;
+		++sSnapshotCount;
+		used += end - begin;
+	}
+	sSnapshotBytesCopied += used;
+}
+
+void GraphicsThreadMain(void *)
+{
+	svcGetThreadId(&sThreadId, CUR_THREAD_HANDLE);
+	while (sRun)
+	{
+		svcWaitSynchronization(sRequest, U64_MAX);
+		if (sRun)
+		{
+			DLParser_RenderTask();
+			FlushRuns();
+			// ARM11 MPCore does not broadcast cache maintenance: clean this
+			// core's D-cache so the GPU and core 0 (which submits and swaps)
+			// see the command lists, vertices and textures written here.
+			_InvalidateAndFlushCaches();
+		}
+		__sync_synchronize();
+		sBusy = false;
+		svcSignalEvent(sDone);
+	}
+}
+}
+
+bool GraphicsThreadCTR_IsAvailable()
+{
+	if (!sTriedCreate)
+	{
+		sTriedCreate = true;
+		svcCreateEvent(&sRequest, RESET_ONESHOT);
+		svcCreateEvent(&sDone, RESET_ONESHOT);
+		sRun = true;
+		// Core 1 time is granted by the audio plugin (APT_SetAppCpuTimeLimit).
+		sThread = threadCreate(GraphicsThreadMain, nullptr, GRAPHICS_THREAD_STACK, GRAPHICS_THREAD_PRIORITY, 1, false);
+		if (sThread == nullptr)
+		{
+			sRun = false;
+			svcCloseHandle(sRequest);
+			svcCloseHandle(sDone);
+		}
+		std::cout << "n64to3ds graphics: core1 thread=" << (sThread != nullptr ? "created" : "not created (synchronous rendering)") << std::endl;
+	}
+	return sThread != nullptr;
+}
+
+bool GraphicsThreadCTR_IsCurrentThread()
+{
+	if (sThread == nullptr || sThreadId == 0)
+		return false;
+	u32 id = 0;
+	svcGetThreadId(&id, CUR_THREAD_HANDLE);
+	return id == sThreadId;
+}
+
+bool GraphicsThreadCTR_IsBusy()
+{
+	return sTaskInFlight;
+}
+
+void GraphicsThreadCTR_StartTask()
+{
+	sTaskInFlight = true;
+	sSpReleased = false;
+	sFullSyncPending = false;
+	sEndOfFramePending = false;
+	sDeferredCycles = GRAPHICS_FIRST_POLL_CYCLES;
+	// The oldest history slot becomes the new task's.
+	const u32 root = reinterpret_cast<const OSTask *>(g_pu8SpMemBase + 0x0FC0)->t.data_ptr & 0x00FFFFFF;
+	sRangeSlot = (sRangeSlot + 1) % kRangeSlots;
+	sRangeCount[sRangeSlot] = 0;
+	sRangeTag[sRangeSlot] = root;
+	BuildSnapshot(root);
+	sRendering = true;
+	sBusy = true;
+	// The same in the other direction for what BeginTask drew on core 0
+	// (bottom screen, clear, GL state).
+	_InvalidateAndFlushCaches();
+	__sync_synchronize();
+	svcSignalEvent(sRequest);
+	CPU_AddEvent(GRAPHICS_FIRST_POLL_CYCLES, CPU_EVENT_GRAPHICS);
+}
+
+u32 GraphicsThreadCTR_Poll()
+{
+	if (sBusy && sDeferredCycles < GRAPHICS_MAX_DEFER_CYCLES)
+	{
+		sDeferredCycles += GRAPHICS_POLL_CYCLES;
+		return GRAPHICS_POLL_CYCLES;
+	}
+	GraphicsThreadCTR_Wait();	// no-op unless the cap was reached
+	return 0;
+}
+
+bool AudioOutputCTR_GetBufferedSamples(u32 * samples);	// HLEAudio/Plugin/CTR/AudioOutput.cpp
+
+namespace
+{
+u32 DpDelayForAudio()
+{
+	u32 samples = 0;
+	if (!AudioOutputCTR_GetBufferedSamples(&samples) || samples > AUDIO_HIGH_SAMPLES)
+		sDpDelayCycles = sDpDelayCycles > DP_DELAY_STEP_DOWN ? sDpDelayCycles - DP_DELAY_STEP_DOWN : 0;
+	else if (samples < AUDIO_LOW_SAMPLES)
+		sDpDelayCycles = std::min(sDpDelayCycles + DP_DELAY_STEP_UP, DP_DELAY_MAX_CYCLES);
+	return sDpDelayCycles;
+}
+}
+
+void GraphicsThreadCTR_CompleteTask()
+{
+	GraphicsThreadCTR_Wait();
+	// Same order as synchronous rendering: the full-sync interrupt is raised
+	// while the display list runs, the frame ends in EndScene, and the SP
+	// task is finished afterwards.
+	if (sFullSyncPending)
+	{
+		sFullSyncPending = false;
+		const u32 delay = DpDelayForAudio();
+		if (delay != 0)
+		{
+			sDpPending = true;
+			CPU_AddEvent(delay, CPU_EVENT_GRAPHICS_DP);
+		}
+		else
+		{
+			Memory_MI_SetRegisterBits(MI_INTR_REG, MI_INTR_DP);
+			gCPUState.AddJob(CPU_CHECK_INTERRUPTS);
+		}
+	}
+	if (sEndOfFramePending)
+	{
+		sEndOfFramePending = false;
+		HandleEndOfFrame();
+	}
+	sRendering = false;
+	sTaskInFlight = false;
+	// A VI origin change while the task rendered was not presented (see
+	// Memory_WriteValue.inl); UpdateScreen() presents it if there was one.
+	gGraphicsPlugin->UpdateScreen();
+	// After an early release the SP may be running another task by now.
+	if (!sSpReleased)
+		RSP_HLE_Finished(SP_STATUS_TASKDONE|SP_STATUS_BROKE|SP_STATUS_HALT);
+	sSpReleased = false;
+}
+
+// An audio task must not wait for core 1.  NuSys asks a running graphics
+// task to yield (SP_SET_YIELD) when audio is due and waits for the SP; HLE
+// cannot yield, so the audio task waited until core 1 had rendered the whole
+// display list, up to three VIs of guest time with the guest idling quickly
+// meanwhile.  The AI FIFO ran dry and the audio manager, catching up, found
+// it FULL and dropped frames (console AISKIP run: ~1 VI per graphics task,
+// 8-15% of audio frames dropped).  Report the task as finished instead of
+// yielded, so libultra treats it as done and runs audio at once.  The
+// full-sync interrupt, which NuSys waits for before it starts the next
+// graphics task, still comes when core 1 is done: the RSP finishing before
+// the RDP, as on the N64.
+//
+// The SP interrupt follows SP_YIELD_CYCLES later (CPU_EVENT_GRAPHICS_YIELD),
+// as a yield takes RSP time: NuSys's audio thread, which asked for it, is
+// waiting for it by then, ahead of its graphics thread on the same queue.
+const u32 SP_YIELD_CYCLES = 20000;
+// Off: on the console the release alone raised presents from 16 to 21/s in
+// HM64's music scenes but slowed the game from 52 to 45 VI/s with twice the
+// underruns; the owner is comparing both.
+const bool GRAPHICS_RELEASE_SP_ON_YIELD = false;
+
+void GraphicsThreadCTR_ReleaseSP()
+{
+	if (!GRAPHICS_RELEASE_SP_ON_YIELD || !sTaskInFlight || sSpReleased)
+		return;
+	sSpReleased = true;
+	const u32 status = Memory_SP_SetRegisterBits(SP_STATUS_REG, SP_STATUS_TASKDONE|SP_STATUS_BROKE|SP_STATUS_HALT);
+	if (status & SP_STATUS_INTR_BREAK)
+		CPU_AddEvent(SP_YIELD_CYCLES, CPU_EVENT_GRAPHICS_YIELD);
+}
+
+void GraphicsThreadCTR_RaiseFullSync()
+{
+	if (!sDpPending)
+		return;
+	sDpPending = false;
+	Memory_MI_SetRegisterBits(MI_INTR_REG, MI_INTR_DP);
+	gCPUState.AddJob(CPU_CHECK_INTERRUPTS);
+}
+
+void GraphicsThreadCTR_Wait()
+{
+	if (sThread == nullptr || GraphicsThreadCTR_IsCurrentThread())
+		return;
+	while (sBusy)
+		svcWaitSynchronization(sDone, 1000000);	// 1 ms; re-check the flag
+	__sync_synchronize();
+}
+
+void GraphicsThreadCTR_Shutdown()
+{
+	if (sThread == nullptr)
+		return;
+	GraphicsThreadCTR_Wait();
+	sRun = false;
+	svcSignalEvent(sRequest);
+	threadJoin(sThread, U64_MAX);
+	threadFree(sThread);
+	sThread = nullptr;
+	sThreadId = 0;
+	svcCloseHandle(sRequest);
+	svcCloseHandle(sDone);
+	sTriedCreate = false;
+}
+
+void GraphicsThreadCTR_DeferFullSync()
+{
+	sFullSyncPending = true;
+}
+
+void GraphicsThreadCTR_DeferEndOfFrame()
+{
+	sEndOfFramePending = true;
+}
+
+void GraphicsThreadCTR_NoteRead(u32 address, u32 length, EGfxRead kind)
+{
+	if (!sRendering || length == 0)
+		return;	// rendering on the CPU thread cannot race with the guest
+	RdramRange & run = sReadRun[kind];
+	if (sReadRunValid[kind] && address >= run.begin && address <= run.end + kRunGap)
+	{
+		if (address + length > run.end)
+			run.end = address + length;
+		return;
+	}
+	if (sReadRunValid[kind])
+		StoreRange(run.begin, run.end);
+	run.begin = address;
+	run.end = address + length;
+	sReadRunValid[kind] = true;
+}
+
+const u8 * GraphicsThreadCTR_RamBase(u32 address, u32 length, EGfxRead kind)
+{
+	if (!sRendering)
+		return g_pu8RamBase;
+	GraphicsThreadCTR_NoteRead(address, length, kind);
+	if (sSnapshotCount == 0)
+		return g_pu8RamBase;
+	const SnapshotRange * r = &sSnapshotRanges[sSnapshotHit[kind]];
+	if (!(address >= r->begin && address + length <= r->end))
+	{
+		// Last range that begins at or before the address.
+		u32 lo = 0, hi = sSnapshotCount;
+		while (lo < hi)
+		{
+			const u32 mid = (lo + hi) / 2;
+			if (sSnapshotRanges[mid].begin <= address)
+				lo = mid + 1;
+			else
+				hi = mid;
+		}
+		if (lo == 0 || address + length > sSnapshotRanges[lo - 1].end)
+		{
+			++sSnapshotMisses[kind];
+			return g_pu8RamBase;
+		}
+		sSnapshotHit[kind] = lo - 1;
+		r = &sSnapshotRanges[lo - 1];
+	}
+	return reinterpret_cast<const u8 *>(reinterpret_cast<uintptr_t>(sSnapshot) + r->offset - r->begin);
+}
+
+void GraphicsThreadCTR_GetSnapshotCounts(u32 * bytes, u32 * misses)
+{
+	*bytes = sSnapshotBytesCopied;
+	*misses = 0;
+	for (u32 k = 0; k < GFX_READ_KINDS; ++k)
+		*misses += sSnapshotMisses[k];
+}
+
+u32 GraphicsThreadCTR_GetSnapshotMisses(EGfxRead kind)
+{
+	return sSnapshotMisses[kind];
+}
diff --git a/Source/SysCTR/HLEGraphics/GraphicsThreadCTR.h b/Source/SysCTR/HLEGraphics/GraphicsThreadCTR.h
new file mode 100644
index 0000000..0a82069
--- /dev/null
+++ b/Source/SysCTR/HLEGraphics/GraphicsThreadCTR.h
@@ -0,0 +1,62 @@
+#pragma once
+
+#include "Base/Types.h"
+
+// n64to3ds: HLE display-list rendering on the Old 3DS system core (core 1).
+//
+// The CPU thread prepares a graphics task (DLParser_BeginTask: presenting the
+// previous frame, the bottom screen, RDP state, BeginScene), the graphics
+// thread renders it (DLParser_RenderTask), and the CPU thread completes it
+// once the thread is done (deferred RDP full-sync interrupt, end-of-frame
+// handling, SP task done).  The guest therefore sees the same order of events
+// as with synchronous rendering, only later, as with a slower RDP.  GL is used
+// by one thread at a time: the CPU thread always waits for the graphics thread
+// before it touches GL or starts another task.
+
+// Creates the thread on first use; false keeps rendering synchronous.
+bool GraphicsThreadCTR_IsAvailable();
+bool GraphicsThreadCTR_IsCurrentThread();
+
+// True while a task is rendering (until the CPU thread has completed it).
+bool GraphicsThreadCTR_IsBusy();
+
+void GraphicsThreadCTR_StartTask();
+// 0 when the task may be completed, else the COUNT cycles until the next check.
+u32  GraphicsThreadCTR_Poll();
+// Completes a finished task on the CPU thread (see above).
+void GraphicsThreadCTR_CompleteTask();
+// The guest asked the running graphics task to yield (SP_SET_YIELD): the SP
+// task is reported finished now, the rest of the completion stays with
+// GraphicsThreadCTR_CompleteTask.
+void GraphicsThreadCTR_ReleaseSP();
+// Raises a full-sync interrupt held back to pace the guest's frames for its
+// audio (see GraphicsThreadCTR.cpp), on CPU_EVENT_GRAPHICS_DP.  The caller
+// removes the event; before another task starts and before a savestate.
+void GraphicsThreadCTR_RaiseFullSync();
+// Blocks until the graphics thread is idle.  No-op on the graphics thread.
+void GraphicsThreadCTR_Wait();
+void GraphicsThreadCTR_Shutdown();
+
+// Called on the graphics thread instead of acting on CPU state directly.
+void GraphicsThreadCTR_DeferFullSync();
+void GraphicsThreadCTR_DeferEndOfFrame();
+
+// RDRAM the guest changes while a task renders.  On the N64 the RSP has read
+// a frame's display list, vertices and matrices a few milliseconds after the
+// task starts; here core 1 may still be rendering when the guest, running
+// on, builds the next frame in the same memory (HM64, console RACECHECK run:
+// ~10% of display list, vertex and matrix reads saw newer data; sprites
+// showed other sprites' textures or vanished).  The graphics thread records
+// the RDRAM it reads; when a task starts, the CPU thread copies what the last
+// tasks with the same root display list read into a snapshot, and reads on
+// the graphics thread come from it.  Reads outside the snapshot use RDRAM.
+enum EGfxRead { GFX_READ_DL, GFX_READ_VERTEX, GFX_READ_MATRIX, GFX_READ_TEXTURE, GFX_READ_OTHER, GFX_READ_KINDS };
+// Records the read and returns the base pointer for it: index it with the
+// RDRAM address, as g_pu8RamBase.  g_pu8RamBase unless a task renders on
+// the graphics thread.
+const u8 * GraphicsThreadCTR_RamBase(u32 address, u32 length, EGfxRead kind);
+// Records a read without reading (texture and palette memory on first use).
+void GraphicsThreadCTR_NoteRead(u32 address, u32 length, EGfxRead kind);
+// Bytes copied into snapshots and reads not in a snapshot (diagnostics).
+void GraphicsThreadCTR_GetSnapshotCounts(u32 * bytes, u32 * misses);
+u32  GraphicsThreadCTR_GetSnapshotMisses(EGfxRead kind);
diff --git a/Source/SysCTR/HLEGraphics/RendererCTR.cpp b/Source/SysCTR/HLEGraphics/RendererCTR.cpp
index c28bd05..27e732b 100644
