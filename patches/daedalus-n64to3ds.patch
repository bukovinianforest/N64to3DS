+
+// Writes the fragments that ran, most executed code first:
+//   "N64FRAG1", u32 count, then per fragment
+//   u32 entry_pc, u32 hits, u32 code_bytes, u32 num_ops, u32 code_address,
+//   num_ops x (u32 opcode, u32 code offset), code_bytes of ARM code.
+// Returns the number of fragments written.
+u32 CFragmentCache::DumpProfile( FILE * fh, u32 max_fragments ) const
+{
+	std::vector< const CFragment * > fragments;
+	for( const SFragmentEntry & entry : mFragments )
+	{
+		if( entry.Fragment->GetProfileHits() != 0 )
+			fragments.push_back( entry.Fragment );
+	}
+	auto weight = []( const CFragment * f ) { return u64( f->GetProfileHits() ) * f->GetOutputLength(); };
+	std::sort( fragments.begin(), fragments.end(),
+		[&weight]( const CFragment * a, const CFragment * b ) { return weight( a ) > weight( b ); } );
+	if( fragments.size() > max_fragments )
+		fragments.resize( max_fragments );
+
+	const u32 count = fragments.size();
+	fwrite( "N64FRAG1", 1, 8, fh );
+	fwrite( &count, 4, 1, fh );
+	for( const CFragment * f : fragments )
+	{
+		const std::vector< u32 > & ops = f->GetProfileOps();
+		const u32 header[5] = { f->GetEntryAddress(), f->GetProfileHits(), f->GetOutputLength(),
+								u32( ops.size() / 2 ), u32( reinterpret_cast< uintptr_t >( f->GetEntryTarget().GetTarget() ) ) };
+		fwrite( header, 4, 5, fh );
+		fwrite( ops.data(), 4, ops.size(), fh );
+		fwrite( f->GetEntryTarget().GetTarget(), 1, f->GetOutputLength(), fh );
+	}
+	return count;
+}
