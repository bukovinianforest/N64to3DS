+// n64to3ds: on-console profiler.  If sdmc:/3ds/n64to3ds-agent/profile exists
+// (it is removed when read, like autoreturn), a thread on core 0 samples the
+// CPU thread's phase (Utility/N64Phase.h) and the guest PC about a thousand
+// times a second; each diag window then logs an "n64to3ds prof:" line with
+// the share of samples per phase and the most sampled guest PCs.
+static const char * kProfileFile = "sdmc:/3ds/n64to3ds-agent/profile";
+static volatile bool sProfileRun = false;
+static Thread sProfileThread = nullptr;
+static Thread sCore1ProfileThread = nullptr;
+static u32 sCore1Samples[C1_PHASE_COUNT];
+static u32 sCore1CmdSamples[256];	// C1_GFX_DL samples by GBI command
+static u32 sPhaseSamples[PHASE_COUNT];
+static u32 sEventSubSamples[64];
+struct ProfilePc { u32 pc; u32 count; };
+static ProfilePc sProfilePcs[256];
+static ProfilePc sInterpPcs[256];	// samples in PHASE_INTERP only
+static u32 sLastGenericCounts[96];
+
+static void ProfileThreadMain(void *)
+{
+	while (sProfileRun)
+	{
+		svcSleepThread(1000000);	// 1 ms
+		const u8 phase = gN64Phase;
+		if (phase >= PHASE_COUNT)
+			continue;
+		++sPhaseSamples[phase];
+		if (phase == PHASE_EVENTS || phase == PHASE_COMPILE)
+			++sEventSubSamples[gN64SubPhase & 63];
+		if (phase != PHASE_JIT && phase != PHASE_INTERP && phase != PHASE_TRACE && phase != PHASE_TLB)
+			continue;
+		// The guest PC is the current fragment's entry while dynarec code runs.
+		const u32 pc = gCPUState.CurrentPC;
+		const u32 hash = ((pc >> 2) * 2654435761u) >> 24;
+		ProfilePc * const tables[2] = { sProfilePcs, phase == PHASE_INTERP ? sInterpPcs : nullptr };
+		for (ProfilePc * table : tables)
+		{
+			for (u32 i = 0; table != nullptr && i < 256; ++i)
+			{
+				ProfilePc & entry = table[(hash + i) & 255];
+				if (entry.count == 0 || entry.pc == pc)
+				{
+					entry.pc = pc;
+					++entry.count;
+					break;
+				}
+			}
+		}
+	}
+}
+
+// Core 1 sampler: above the audio (0x19) and graphics (0x1A) threads,
+// see gN64Core1PriorityShift.
+static void Core1ProfileThreadMain(void *)
+{
+	while (sProfileRun)
+	{
+		svcSleepThread(1000000);	// 1 ms
+		const u8 phase = gN64Core1Phase;
+		if (phase < C1_PHASE_COUNT)
+			++sCore1Samples[phase];
+		if (phase == C1_GFX_DL)
+			++sCore1CmdSamples[gN64Core1Cmd];	// the command handlers' own time
+	}
+}
+
+static void SetupProfiler()
+{
+	{
+		std::ifstream in(kProfileFile);
+		if (!in)
+			return;
+	}
+	std::remove(kProfileFile);
+	sProfileRun = true;
+	gN64ProfileGenericOps = true;	// before any fragment is compiled
+	// Above the CPU thread (0x30) on its core, so samples land while it runs.
+	sProfileThread = threadCreate(ProfileThreadMain, nullptr, 4096, 0x20, 0, false);
+	if (sProfileThread == nullptr)
+		sProfileRun = false;
+	else
+		sCore1ProfileThread = threadCreate(Core1ProfileThreadMain, nullptr, 4096, 0x18, 1, false);
+	std::cout << "n64to3ds profile: sampler " << (sProfileThread != nullptr ? "started" : "not started")
+		<< ", core 1 sampler " << (sCore1ProfileThread != nullptr ? "started" : "not started") << std::endl;
+}
+
+static void StopProfiler()
+{
+	if (sProfileThread == nullptr)
+		return;
+	sProfileRun = false;
+	threadJoin(sProfileThread, U64_MAX);
+	threadFree(sProfileThread);
+	sProfileThread = nullptr;
+	if (sCore1ProfileThread != nullptr)
+	{
+		threadJoin(sCore1ProfileThread, U64_MAX);
+		threadFree(sCore1ProfileThread);
+		sCore1ProfileThread = nullptr;
+	}
+}
