+template <bool Up> inline void EnvStep3(EnvRamp3 &r) {
+  r.acc += r.adder;
+  r.vol += (r.acc >> 16);
+  r.acc &= 0xFFFF;
+  if (Up) {
+    if (r.vol > r.trg) r.vol = r.trg;
+  } else {
+    if (r.vol < r.trg) r.vol = r.trg;
+  }
