+// n64to3ds: removes the first queued event of this type.  Event counts are
+// deltas, so the removed event's count moves to the one after it.
+static bool CPU_RemoveEvent( ECPUEventType event_type )
+{
+	for( u32 i = 0; i < gCPUState.NumEvents; ++i )
+	{
+		if( gCPUState.Events[ i ].mEventType != event_type )
+			continue;
+		if( i + 1 < gCPUState.NumEvents )
+		{
+			gCPUState.Events[ i + 1 ].mCount += gCPUState.Events[ i ].mCount;
+			memmove( &gCPUState.Events[ i ], &gCPUState.Events[ i + 1 ], ( gCPUState.NumEvents - i - 1 ) * sizeof( CPUEvent ) );
+		}
+		gCPUState.NumEvents--;
+		return true;
+	}
+	return false;
