+// n64to3ds: dynarec code dump for profiled runs.  If
+// sdmc:/3ds/n64to3ds-agent/codedump holds "<start> <end>" seconds (removed
+// when read), fragment hit counts are reset at start and the most executed
+// fragments, with their ARM code, are written to codedump.bin at end
+// (format: CFragmentCache::DumpProfile).  Needs the profile file too, which
+// makes fragments count their own entries.
+static const char * kCodeDumpFile = "sdmc:/3ds/n64to3ds-agent/codedump";
+static u64 sCodeDumpStart = 0;	// system ticks, 0 = done or off
+static u64 sCodeDumpEnd = 0;
+
+static void SetupCodeDump()
+{
+	long start = 0, end = 0;
+	{
+		std::ifstream in(kCodeDumpFile);
+		if (!(in >> start >> end))
+			return;
+	}
+	std::remove(kCodeDumpFile);
+	if (!gN64ProfileGenericOps || start < 0 || end <= start || end > 3600)
+		return;
+	const u64 now = svcGetSystemTick();
+	sCodeDumpStart = now + u64(start) * u64(SYSCLOCK_ARM11);
+	sCodeDumpEnd = now + u64(end) * u64(SYSCLOCK_ARM11);
+	std::cout << "n64to3ds codedump: " << start << " s to " << end << " s" << std::endl;
+}
+
+static void UpdateCodeDump(u64 now)
+{
+	if (sCodeDumpStart != 0 && now >= sCodeDumpStart)
+	{
+		gFragmentCache.ResetProfileHits();
+		sCodeDumpStart = 0;
+	}
+	if (sCodeDumpStart != 0 || sCodeDumpEnd == 0 || now < sCodeDumpEnd)
+		return;
+	sCodeDumpEnd = 0;
+	if (FILE * file = fopen("sdmc:/3ds/n64to3ds-agent/codedump.bin", "wb"))
+	{
+		// Few large SD writes (see SaveTopScreen).
+		static char buffer[64 * 1024];
+		setvbuf(file, buffer, _IOFBF, sizeof(buffer));
+		const u32 count = gFragmentCache.DumpProfile(file, 800);
+		fclose(file);
+		std::cout << "n64to3ds codedump: " << count << " fragments of "
+			<< gFragmentCache.GetCacheSize() << std::endl;
+	}
