+    u8 *p = buffer + offset;
+    const u32 in = LoadWord(p + kIn);
+    u32 out = LoadWord(p + kOut), a1 = LoadWord(p + kAux1);
+    u32 a2 = LoadWord(p + kAux2), a3 = LoadWord(p + kAux3);
+
+    // y = 2k -> element 2k + 1 (high halfword)
+    EnvStep3<LUp>(l);
+    EnvStep3<RUp>(r);
+    s32 i1 = (s16)(in >> 16);
+    s32 mainL = ((Dry * l.vol) + 0x4000) >> 15, mainR = ((Dry * r.vol) + 0x4000) >> 15;
+    s32 auxL = ((Wet * l.vol) + 0x4000) >> 15, auxR = ((Wet * r.vol) + 0x4000) >> 15;
+    const u32 outH = (u16)Mix3((s16)(out >> 16), i1, mainL), a1H = (u16)Mix3((s16)(a1 >> 16), i1, mainR);
+    const u32 a2H = (u16)Mix3((s16)(a2 >> 16), i1, auxL), a3H = (u16)Mix3((s16)(a3 >> 16), i1, auxR);
+
+    // y = 2k + 1 -> element 2k (low halfword)
+    EnvStep3<LUp>(l);
+    EnvStep3<RUp>(r);
+    i1 = (s16)in;
+    mainL = ((Dry * l.vol) + 0x4000) >> 15; mainR = ((Dry * r.vol) + 0x4000) >> 15;
+    auxL = ((Wet * l.vol) + 0x4000) >> 15; auxR = ((Wet * r.vol) + 0x4000) >> 15;
+    out = (outH << 16) | (u16)Mix3((s16)out, i1, mainL);
+    a1 = (a1H << 16) | (u16)Mix3((s16)a1, i1, mainR);
+    a2 = (a2H << 16) | (u16)Mix3((s16)a2, i1, auxL);
+    a3 = (a3H << 16) | (u16)Mix3((s16)a3, i1, auxR);
