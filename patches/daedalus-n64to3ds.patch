+  const s32 auxL = ((Wet * l.vol) + 0x4000) >> 15, auxR = ((Wet * r.vol) + 0x4000) >> 15;
+  for (; offset < 0x170; offset += 4) {
+    u8 *p = buffer + offset;
+    const u32 in = LoadWord(p + kIn);
+    const u32 out = LoadWord(p + kOut), a1 = LoadWord(p + kAux1);
+    const u32 a2 = LoadWord(p + kAux2), a3 = LoadWord(p + kAux3);
+    const s32 iH = (s16)(in >> 16), iL = (s16)in;
+    StoreWord(p + kOut, ((u32)(u16)Mix3((s16)(out >> 16), iH, mainL) << 16) | (u16)Mix3((s16)out, iL, mainL));
+    StoreWord(p + kAux1, ((u32)(u16)Mix3((s16)(a1 >> 16), iH, mainR) << 16) | (u16)Mix3((s16)a1, iL, mainR));
+    StoreWord(p + kAux2, ((u32)(u16)Mix3((s16)(a2 >> 16), iH, auxL) << 16) | (u16)Mix3((s16)a2, iL, auxL));
+    StoreWord(p + kAux3, ((u32)(u16)Mix3((s16)(a3 >> 16), iH, auxR) << 16) | (u16)Mix3((s16)a3, iL, auxR));
+  }
+}
+}
