diff --git a/Source/SysCTR/Utility/CacheCTR.S b/Source/SysCTR/Utility/CacheCTR.S
index 62dd4ec..e363f2c 100644
--- a/Source/SysCTR/Utility/CacheCTR.S
+++ b/Source/SysCTR/Utility/CacheCTR.S
@@ -1,6 +1,7 @@
 .arm
 
 .global _InvalidateAndFlushCaches
+.global _InvalidateAndFlushCacheRange
 
 _ClearCacheKernel:
 	cpsid aif
@@ -12,6 +13,70 @@ _ClearCacheKernel:
 	bx lr
 
 _InvalidateAndFlushCaches:
+	@ Azahar/Citra do not implement svcCustomBackdoor, so the JIT would keep
+	@ running stale translations of patched dynarec code.  There the HLE
+	@ kernel's svcInvalidateEntireInstructionCache drops the translations.
+	ldr r0, =_ctrRunningInEmulator
+	ldr r0, [r0]
+	cmp r0, #0
+	bne 1f
 	ldr r0, =_ClearCacheKernel
 	svc 0x80					@ svcCustomBackdoor
-	bx lr
\ No newline at end of file
+	bx lr
+1:
+	svc 0x94					@ svcInvalidateEntireInstructionCache
+	bx lr
+
+@ n64to3ds: the range for _ClearCacheRangeKernel, [start, end).  Only the
+@ CPU thread on core 0 writes dynarec code, so one pair is enough.
+.data
+.align 2
+_cacheRangeStart:	.word 0
+_cacheRangeEnd:		.word 0
+.text
+.arm
+
+@ Kernel mode (svcCustomBackdoor): clean the data cache and invalidate the
+@ instruction cache for the 32-byte lines of the range only.  The whole-cache
+@ version cost every new dynarec block and every patched link a full D-cache
+@ clean and threw all hot code out of the I-cache (stutter whenever a game
+@ enters new code: GoldenEye compiled ~300 blocks with ~600 flushes in one
+@ 425 ms frame).
+_ClearCacheRangeKernel:
+	cpsid aif
+	ldr r1, =_cacheRangeStart
+	ldr r0, [r1]
+	ldr r1, [r1, #4]
+	bic r0, r0, #31
+1:
+	mcr p15, 0, r0, c7, c10, 1	@ Clean data cache line by MVA
+	mcr p15, 0, r0, c7, c5, 1	@ Invalidate instruction cache line by MVA
+	add r0, r0, #32
+	cmp r0, r1
+	blo 1b
+	mov r0, #0
+	mcr p15, 0, r0, c7, c10, 4	@ Data Sync Barrier
+	mcr p15, 0, r0, c7, c5, 6	@ Flush branch target cache
+	mcr p15, 0, r0, c7, c5, 4	@ Flush prefetch buffer
+	bx lr
+
+@ void _InvalidateAndFlushCacheRange(void *addr, u32 size)
+@ Under Azahar/Citra only the JIT translations of the code that was just
+@ written are dropped; a full svcInvalidateEntireInstructionCache per dynarec
+@ block made the emulator itself stall while it re-translated everything.
+@ Real hardware cleans and invalidates just the lines of the range.
+_InvalidateAndFlushCacheRange:
+	ldr r2, =_ctrRunningInEmulator
+	ldr r2, [r2]
+	cmp r2, #0
+	bne 2f
+	ldr r2, =_cacheRangeStart
+	add r1, r0, r1
+	str r0, [r2]
+	str r1, [r2, #4]
+	ldr r0, =_ClearCacheRangeKernel
+	svc 0x80					@ svcCustomBackdoor
+	bx lr
+2:
+	svc 0x93					@ svcInvalidateInstructionCacheRange(addr, size)
+	bx lr
diff --git a/Source/SysCTR/Utility/MemoryCTR.c b/Source/SysCTR/Utility/MemoryCTR.c
index 228fb3a..83e7dcb 100644
--- a/Source/SysCTR/Utility/MemoryCTR.c
+++ b/Source/SysCTR/Utility/MemoryCTR.c
@@ -11,6 +11,9 @@ int __stacksize__ = 2 * 1024 * 1024;
 
 static int hack3dsSvcInitialized = 0;
 
+// Set when running under Azahar/Citra; read by _InvalidateAndFlushCaches.
