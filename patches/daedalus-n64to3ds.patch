index 0000000..9de16e8
--- /dev/null
+++ b/Source/SysCTR/Graphics/GLStateCacheCTR.cpp
@@ -0,0 +1,386 @@
+// n64to3ds: GL state cache and draw batching for picaGL (see the header).
+
+#define GLCACHE_NO_MACROS
+#include "SysCTR/Graphics/GLStateCacheCTR.h"
+
+#include <cstring>
+
+namespace
+{
+	// Small open tables: the renderer touches a handful of caps and pnames.
+	// When a table is full, calls go straight through (after a flush).
+	template <unsigned N>
+	struct KeyedInts
+	{
+		GLenum keys[N];
+		GLint  values[N];
+		unsigned used = 0;
+
+		void Clear() { used = 0; }
+		GLint * Find(GLenum key)
+		{
+			for (unsigned i = 0; i < used; ++i)
+				if (keys[i] == key)
+					return &values[i];
+			return nullptr;
+		}
+		GLint * Insert(GLenum key)
+		{
+			if (used == N)
+				return nullptr;
+			keys[used] = key;
+			return &values[used++];
+		}
+	};
+
+	struct State
+	{
+		KeyedInts<24> caps;			// 0/1 per capability
+		KeyedInts<16> tex_env;			// GL_TEXTURE_ENV pname -> param
+		KeyedInts<8>  tex_params;		// for bound_texture only
+
+		bool    blend_valid = false;	GLenum blend_s = 0, blend_d = 0;
+		bool    blend_eq_valid = false;	GLenum blend_eq = 0;
+		bool    alpha_valid = false;	GLenum alpha_func = 0;	GLclampf alpha_ref = 0.0f;
+		bool    depth_mask_valid = false;	GLboolean depth_mask = 0;
+		bool    depth_func_valid = false;	GLenum depth_func = 0;
+		bool    poly_valid = false;		GLfloat poly_factor = 0.0f, poly_units = 0.0f;
+		bool    env_color_valid = false;	GLfloat env_color[4] = {};
+		bool    colour_valid = false;	GLfloat colour[3] = {};
+		bool    bound_valid = false;	GLuint bound_texture = 0;
+		bool    matrix_mode_valid = false;	GLenum matrix_mode = 0;
+		bool    projection_valid = false;	GLfloat projection[16] = {};
+	};
+
+	struct PendingDraw
+	{
+		bool    active = false;
+		GLint   first = 0;
+		GLsizei count = 0;
+	};
+
+	State       sState;
+	PendingDraw sPending;
+	unsigned    sSubmitted = 0;
+	unsigned    sRequested = 0;
+
+	void ForgetState()
+	{
+		sState = State();
+	}
+
+	// Set a 0/1 value in a table; returns false when nothing changes.
+	template <unsigned N>
+	bool Update(KeyedInts<N> & table, GLenum key, GLint value)
+	{
+		if (GLint * v = table.Find(key))
+		{
+			if (*v == value)
+				return false;
+			GLCache_Flush();
+			*v = value;
+			return true;
+		}
+		GLCache_Flush();
+		if (GLint * v = table.Insert(key))
+			*v = value;
+		return true;
+	}
+}
+
+void GLCache_Flush()
+{
+	if (sPending.active)
+	{
+		sPending.active = false;
+		glDrawArrays(GL_TRIANGLES, sPending.first, sPending.count);
+		++sSubmitted;
+	}
+}
+
+void GLCache_Invalidate()
+{
+	GLCache_Flush();
+	ForgetState();
+}
+
+void GLCache_GetDrawCounts(unsigned * submitted, unsigned * requested)
+{
+	*submitted = sSubmitted;
+	*requested = sRequested;
+}
+
+void GLCache_Enable(GLenum cap)
+{
+	if (Update(sState.caps, cap, 1))
+		glEnable(cap);
+}
+
+void GLCache_Disable(GLenum cap)
+{
+	if (Update(sState.caps, cap, 0))
+		glDisable(cap);
+}
+
+void GLCache_BlendFunc(GLenum sfactor, GLenum dfactor)
+{
+	if (sState.blend_valid && sState.blend_s == sfactor && sState.blend_d == dfactor)
+		return;
+	GLCache_Flush();
+	sState.blend_valid = true; sState.blend_s = sfactor; sState.blend_d = dfactor;
+	glBlendFunc(sfactor, dfactor);
+}
+
+void GLCache_BlendEquation(GLenum mode)
+{
+	if (sState.blend_eq_valid && sState.blend_eq == mode)
+		return;
+	GLCache_Flush();
+	sState.blend_eq_valid = true; sState.blend_eq = mode;
+	glBlendEquation(mode);
+}
+
+void GLCache_AlphaFunc(GLenum func, GLclampf ref)
+{
+	if (sState.alpha_valid && sState.alpha_func == func && sState.alpha_ref == ref)
+		return;
+	GLCache_Flush();
+	sState.alpha_valid = true; sState.alpha_func = func; sState.alpha_ref = ref;
+	glAlphaFunc(func, ref);
+}
+
+void GLCache_DepthMask(GLboolean flag)
+{
+	if (sState.depth_mask_valid && sState.depth_mask == flag)
+		return;
+	GLCache_Flush();
+	sState.depth_mask_valid = true; sState.depth_mask = flag;
+	glDepthMask(flag);
+}
+
+void GLCache_DepthFunc(GLenum func)
+{
+	if (sState.depth_func_valid && sState.depth_func == func)
+		return;
+	GLCache_Flush();
+	sState.depth_func_valid = true; sState.depth_func = func;
+	glDepthFunc(func);
+}
+
+void GLCache_PolygonOffset(GLfloat factor, GLfloat units)
+{
+	if (sState.poly_valid && sState.poly_factor == factor && sState.poly_units == units)
+		return;
+	GLCache_Flush();
+	sState.poly_valid = true; sState.poly_factor = factor; sState.poly_units = units;
+	glPolygonOffset(factor, units);
+}
+
+void GLCache_TexEnvi(GLenum target, GLenum pname, GLint param)
+{
+	if (target != GL_TEXTURE_ENV)
+	{
+		GLCache_Flush();
+		glTexEnvi(target, pname, param);
+		return;
+	}
+	if (Update(sState.tex_env, pname, param))
+		glTexEnvi(target, pname, param);
+}
+
+void GLCache_TexEnvfv(GLenum target, GLenum pname, const GLfloat * params)
+{
+	if (target == GL_TEXTURE_ENV && pname == GL_TEXTURE_ENV_COLOR)
+	{
+		if (sState.env_color_valid && std::memcmp(sState.env_color, params, sizeof(sState.env_color)) == 0)
+			return;
+		GLCache_Flush();
+		sState.env_color_valid = true;
+		std::memcpy(sState.env_color, params, sizeof(sState.env_color));
+		glTexEnvfv(target, pname, params);
+		return;
+	}
+	GLCache_Flush();
+	glTexEnvfv(target, pname, params);
+}
+
+void GLCache_TexParameteri(GLenum target, GLenum pname, GLint param)
+{
+	// Always passed to picaGL (see GLCache_BindTexture).  A value that is
+	// already set on the bound texture does not change the state of the
+	// deferred draw, so it does not submit it.
+	if (target == GL_TEXTURE_2D && sState.bound_valid)
+	{
+		if (GLint * v = sState.tex_params.Find(pname))
+		{
+			if (*v == param)
+			{
+				glTexParameteri(target, pname, param);
+				return;
+			}
+			GLCache_Flush();
+			*v = param;
+			glTexParameteri(target, pname, param);
+			return;
+		}
+		GLCache_Flush();
+		if (GLint * v = sState.tex_params.Insert(pname))
+			*v = param;
+		glTexParameteri(target, pname, param);
+		return;
+	}
+	GLCache_Flush();
+	glTexParameteri(target, pname, param);
+}
+
+void GLCache_BindTexture(GLenum target, GLuint texture)
+{
+	// Never skipped: picaGL needs every bind, even of the texture that is
+	// already bound (skipping repeated binds drew some HM64 textures black).
+	// Re-binding the texture the deferred draw already uses does not change
+	// its state, so only a different texture submits the deferred draw.
+	if (target == GL_TEXTURE_2D && sState.bound_valid && sState.bound_texture == texture)
+	{
+		glBindTexture(target, texture);
+		return;
+	}
+	GLCache_Flush();
+	glBindTexture(target, texture);
+	if (target == GL_TEXTURE_2D)
+	{
+		sState.bound_valid = true;
+		sState.bound_texture = texture;
+		sState.tex_params.Clear();
+	}
+}
+
+void GLCache_MatrixMode(GLenum mode)
+{
+	if (sState.matrix_mode_valid && sState.matrix_mode == mode)
+		return;
+	GLCache_Flush();
+	sState.matrix_mode_valid = true; sState.matrix_mode = mode;
+	glMatrixMode(mode);
+}
+
+void GLCache_LoadMatrixf(const GLfloat * m)
+{
+	const bool projection = sState.matrix_mode_valid && sState.matrix_mode == GL_PROJECTION;
+	if (projection && sState.projection_valid && std::memcmp(sState.projection, m, sizeof(sState.projection)) == 0)
+		return;
+	GLCache_Flush();
+	glLoadMatrixf(m);
+	if (projection)
+	{
+		sState.projection_valid = true;
+		std::memcpy(sState.projection, m, sizeof(sState.projection));
+	}
+	else if (!sState.matrix_mode_valid)
+	{
+		sState.projection_valid = false;
+	}
+}
+
+void GLCache_LoadIdentity()
+{
+	GLCache_Flush();
+	glLoadIdentity();
+	if (!sState.matrix_mode_valid || sState.matrix_mode == GL_PROJECTION)
+		sState.projection_valid = false;
+}
+
+void GLCache_DrawArrays(GLenum mode, GLint first, GLsizei count)
+{
+	if (count <= 0)
+		return;
+	++sRequested;
+	if (mode == GL_TRIANGLES)
+	{
+		if (sPending.active && first == sPending.first + sPending.count)
+		{
+			sPending.count += count;
+			return;
+		}
+		GLCache_Flush();
+		sPending.active = true;
+		sPending.first = first;
+		sPending.count = count;
+		return;
+	}
+	GLCache_Flush();
+	glDrawArrays(mode, first, count);
+	++sSubmitted;
+}
+
+void GLCache_Viewport(GLint x, GLint y, GLsizei width, GLsizei height)
+{
+	GLCache_Flush();
+	glViewport(x, y, width, height);
+}
+
+void GLCache_Scissor(GLint x, GLint y, GLsizei width, GLsizei height)
+{
+	GLCache_Flush();
+	glScissor(x, y, width, height);
+}
+
+void GLCache_Clear(GLbitfield mask)
+{
+	GLCache_Flush();
+	glClear(mask);
+}
+
+void GLCache_ClearColor(GLclampf r, GLclampf g, GLclampf b, GLclampf a)
+{
+	GLCache_Flush();
+	glClearColor(r, g, b, a);
+}
+
+void GLCache_ClearDepth(GLclampd depth)
+{
+	GLCache_Flush();
+	glClearDepth(depth);
+}
+
+void GLCache_TexImage2D(GLenum target, GLint level, GLint internalformat, GLsizei width, GLsizei height,
+	GLint border, GLenum format, GLenum type, const GLvoid * pixels)
+{
+	GLCache_Flush();
+	glTexImage2D(target, level, internalformat, width, height, border, format, type, pixels);
+	// An upload can move the texture's memory; picaGL takes the address when
+	// a texture is bound, so the next bind must reach it even for the same id.
+	sState.bound_valid = false;
+	sState.tex_params.Clear();
+}
+
+void GLCache_GenTextures(GLsizei n, GLuint * textures)
+{
+	GLCache_Flush();
+	glGenTextures(n, textures);
+	sState.bound_valid = false;
+	sState.tex_params.Clear();
+}
+
+void GLCache_DeleteTextures(GLsizei n, const GLuint * textures)
+{
+	GLCache_Flush();
+	glDeleteTextures(n, textures);
+	// Deleting the bound texture rebinds 0; just forget the binding.
+	sState.bound_valid = false;
+	sState.tex_params.Clear();
+}
+
+void GLCache_Fogi(GLenum pname, GLint param)
+{
+	GLCache_Flush();
+	glFogi(pname, param);
+}
+
+void GLCache_Color3f(GLfloat r, GLfloat g, GLfloat b)
+{
+	if (sState.colour_valid && sState.colour[0] == r && sState.colour[1] == g && sState.colour[2] == b)
+		return;
+	GLCache_Flush();
+	sState.colour_valid = true; sState.colour[0] = r; sState.colour[1] = g; sState.colour[2] = b;
+	glColor3f(r, g, b);
+}
diff --git a/Source/SysCTR/Graphics/GLStateCacheCTR.h b/Source/SysCTR/Graphics/GLStateCacheCTR.h
new file mode 100644
index 0000000..cfec8cc
--- /dev/null
+++ b/Source/SysCTR/Graphics/GLStateCacheCTR.h
@@ -0,0 +1,87 @@
+// n64to3ds: GL state cache and draw batching for picaGL.
+//
+// The renderer sets every piece of GL state before each draw, and HM64 issues
+// ~85 draws per VI with ~6-7 vertices each.  On an Old 3DS, glDrawArrays alone
+// cost ~5% of the time (~18 us per call) and the state calls another ~4%.
+//
+// Calls are routed here (macros below, included after <GL/picaGL.h>):
+//  * state calls are dropped when the value is unchanged;
+//  * glDrawArrays(GL_TRIANGLES) is deferred; the next one is merged into it
+//    when no state changed in between and its vertices directly follow;
+//  * any real state change, clear, texture upload or other draw first submits
+//    the deferred draw, so the order of GPU work never changes.
+// Code that changes GL state without going through these wrappers (the ImGui
+// backend, the bottom-screen UI) must call GLCache_Flush() before and
+// GLCache_Invalidate() after.
+#ifndef SYSCTR_GRAPHICS_GLSTATECACHECTR_H_
+#define SYSCTR_GRAPHICS_GLSTATECACHECTR_H_
+
+#include <cstddef>	// picaGL.h uses size_t without including it
+#include <GL/picaGL.h>
+
+// Submit the deferred draw, if any.
+void GLCache_Flush();
+// Submit the deferred draw and forget all cached state.
+void GLCache_Invalidate();
+// Draws submitted to picaGL and draws requested, for diagnostics.
+void GLCache_GetDrawCounts(unsigned * submitted, unsigned * requested);
+
+void GLCache_Enable(GLenum cap);
+void GLCache_Disable(GLenum cap);
+void GLCache_BlendFunc(GLenum sfactor, GLenum dfactor);
+void GLCache_BlendEquation(GLenum mode);
+void GLCache_AlphaFunc(GLenum func, GLclampf ref);
+void GLCache_DepthMask(GLboolean flag);
+void GLCache_DepthFunc(GLenum func);
+void GLCache_PolygonOffset(GLfloat factor, GLfloat units);
+void GLCache_TexEnvi(GLenum target, GLenum pname, GLint param);
+void GLCache_TexEnvfv(GLenum target, GLenum pname, const GLfloat * params);
+void GLCache_TexParameteri(GLenum target, GLenum pname, GLint param);
+void GLCache_BindTexture(GLenum target, GLuint texture);
+void GLCache_MatrixMode(GLenum mode);
+void GLCache_LoadMatrixf(const GLfloat * m);
+void GLCache_LoadIdentity();
+void GLCache_DrawArrays(GLenum mode, GLint first, GLsizei count);
+// Calls that are not cached but must keep their order relative to draws.
+void GLCache_Viewport(GLint x, GLint y, GLsizei width, GLsizei height);
+void GLCache_Scissor(GLint x, GLint y, GLsizei width, GLsizei height);
+void GLCache_Clear(GLbitfield mask);
+void GLCache_ClearColor(GLclampf r, GLclampf g, GLclampf b, GLclampf a);
+void GLCache_ClearDepth(GLclampd depth);
+void GLCache_TexImage2D(GLenum target, GLint level, GLint internalformat, GLsizei width, GLsizei height,
+	GLint border, GLenum format, GLenum type, const GLvoid * pixels);
+void GLCache_GenTextures(GLsizei n, GLuint * textures);
+void GLCache_DeleteTextures(GLsizei n, const GLuint * textures);
+void GLCache_Fogi(GLenum pname, GLint param);
+void GLCache_Color3f(GLfloat r, GLfloat g, GLfloat b);
+
+#ifndef GLCACHE_NO_MACROS
+#define glEnable          GLCache_Enable
+#define glDisable         GLCache_Disable
+#define glBlendFunc       GLCache_BlendFunc
+#define glBlendEquation   GLCache_BlendEquation
+#define glAlphaFunc       GLCache_AlphaFunc
+#define glDepthMask       GLCache_DepthMask
+#define glDepthFunc       GLCache_DepthFunc
+#define glPolygonOffset   GLCache_PolygonOffset
+#define glTexEnvi         GLCache_TexEnvi
+#define glTexEnvfv        GLCache_TexEnvfv
+#define glTexParameteri   GLCache_TexParameteri
+#define glBindTexture     GLCache_BindTexture
+#define glMatrixMode      GLCache_MatrixMode
+#define glLoadMatrixf     GLCache_LoadMatrixf
+#define glLoadIdentity    GLCache_LoadIdentity
+#define glDrawArrays      GLCache_DrawArrays
+#define glViewport        GLCache_Viewport
+#define glScissor         GLCache_Scissor
+#define glClear           GLCache_Clear
+#define glClearColor      GLCache_ClearColor
+#define glClearDepth      GLCache_ClearDepth
+#define glTexImage2D      GLCache_TexImage2D
+#define glGenTextures     GLCache_GenTextures
+#define glDeleteTextures  GLCache_DeleteTextures
+#define glFogi            GLCache_Fogi
+#define glColor3f         GLCache_Color3f
+#endif
+
+#endif // SYSCTR_GRAPHICS_GLSTATECACHECTR_H_
