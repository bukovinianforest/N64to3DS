 }
 
+// n64to3ds: the bottom-screen UI (ImGui menu or a game extension) used to be
+// rebuilt and drawn on every guest frame, 2.6-3.6% of the time on an Old 3DS
+// (HM64).  It is now redrawn while the screen is touched, on the frame after
+// a touch ends (so ImGui sees the release), and every kBottomRefreshFrames
+// frames for live content.  On other frames only the top screen is swapped,
+// so the bottom screen keeps showing its last image.
+static const u32 kBottomRefreshFrames = 20;
+static u32  sFramesSinceBottomDraw = kBottomRefreshFrames;
+static bool sTouchHeldLastFrame = false;
+static bool sBottomDrawnThisFrame = false;
+
+static bool BottomScreenNeedsRedraw()
+{
+	const bool touch_held = (hidKeysHeld() & KEY_TOUCH) != 0;
+	const bool redraw = touch_held || sTouchHeldLastFrame || sFramesSinceBottomDraw >= kBottomRefreshFrames;
+	sTouchHeldLastFrame = touch_held;
+	return redraw;
+}
+
 void IGraphicsContext::BeginFrame()
 {
+	// n64to3ds: the client array pointers below and the bottom-screen UI
+	// bypass the GL state cache; submit any deferred draw first.
+	GLCache_Flush();
 	if(newFrame)
 	{
-		UI::DrawInGameMenu();
+		if (BottomScreenNeedsRedraw())
+		{
+#ifdef N64TO3DS_DUALSCREEN
+			// n64to3ds: a game extension owns the bottom screen when one is
+			// active; otherwise (or on its Menu tab) the stock menu is drawn.
+			if (!n64to3ds::DualScreen_DrawBottomScreen())
+#endif
+			UI::DrawInGameMenu();
+			// ImGui and the menu change GL state behind the cache's back.
+			GLCache_Invalidate();
+			sBottomDrawnThisFrame = true;
+			sFramesSinceBottomDraw = 0;
+		}
+		else
+		{
+			++sFramesSinceBottomDraw;
+		}
 		ClearToBlack();
 		newFrame = false;
 	}
@@ -187,12 +232,20 @@ void IGraphicsContext::BeginFrame()
 
 void IGraphicsContext::EndFrame()
 {
-	HandleEndOfFrame();
+	GLCache_Flush();
+	// n64to3ds: HandleEndOfFrame() runs the APT loop and may halt the CPU; on
+	// the graphics thread it is left to the CPU thread (task completion).
+	if (GraphicsThreadCTR_IsCurrentThread())
+		GraphicsThreadCTR_DeferEndOfFrame();
+	else
+		HandleEndOfFrame();
 }
 
 void IGraphicsContext::UpdateFrame(bool wait_for_vbl)
 {
-	pglSwapBuffers();
+	GLCache_Flush();
+	pglSwapBuffersEx(1, sBottomDrawnThisFrame ? 1 : 0);
+	sBottomDrawnThisFrame = false;
 
 	newFrame = true;
 }
