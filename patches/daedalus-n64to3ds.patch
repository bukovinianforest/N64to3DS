+#ifdef DAEDALUS_CTR
+// n64to3ds: real-time VI pacing.
+//
+// Daedalus raises the guest's VI every (V_SYNC+1)*1500 COUNT cycles of guest
+// work, so when the emulated CPU is slow the VIs come late in real time and
+// everything the guest does per VI stretches with them, above all its
+// audio: NuSys makes one audio frame per retrace, at most 552 samples, so at
+// 54 VI/s HM64 made 10% too little audio (console, 746 ring underruns/min).
+// Here the VI period in cycles adapts so that VIs come every TV frame of
+// real time whatever the speed: the guest sees a slower CPU, drops frames of
+// its own accord and keeps its audio and retrace-driven logic at full rate,
+// as on an N64 with a slower CPU.  When the guest is ahead of real time the
+// period stays at the full 1500 cycles per line and FramerateLimiter sleeps.
+// The AI model drains one TV frame of audio per VI (CPU_GetAICountHz), so a
+// shorter VI does not make the guest produce less audio for it.
+//
+// The audio ring trims the pace.  The guest's audio manager makes at most 552
+// samples per retrace, 3.5% above the 533 a 60 Hz retrace needs, and loses
+// some frames to graphics tasks it cannot interrupt, so at exactly real time
+// it stays a few percent short and the ring sits at its floor (console: 59
+// VI/s, ring at ~200 of 8192 samples, 664 underruns/min).  Below the ring
+// setpoint the VIs come up to kVIRingTrimMax faster than real time, above
+// it slower: production settles on the DSP's consumption with margin in
+// the ring.  Only the guest's retrace rate moves, by a few percent; the
+// samples keep their pitch.
+const bool		CTR_REALTIME_VI = true;
+const float		kVIMaxCyclesPerLine = 1500.0f;	// full N64 speed
+// 20%.  Mario Kart 64 (console, in a race) stayed on a 40% floor at 40 VI/s:
+// its code runs at about half HM64's instructions per second in the dynarec,
+// so even 40% of the N64's cycles per VI took 24 ms.  The floor only binds
+// when the console cannot keep real time at all; the game's total CPU budget
+// is the host's speed either way, the floor just decides how many retraces
+// (and so audio frames) that budget is spread over.
+const float		kVIMinCyclesPerLine = 300.0f;
+const float		kVIRingSetpoint = 0.5f;			// of the ring
+const float		kVIRingGain = 0.3f;				// trim per unit of fill error: +8% at 27% below the setpoint
+const float		kVIRingTrimMax = 0.08f;
+static float	sVICyclesPerLine = kVIMaxCyclesPerLine;
+static float	sVITrim = 0.0f;
+static float	sVIWorkAvg = 0.0f;	// real ticks per VI, exponential average over ~8 VIs
+static u64		sVIWorkStart = 0;	// tick after the limiter at the previous VBL
+bool AudioOutputCTR_GetRingFill(float * fill);	// HLEAudio/Plugin/CTR/AudioOutput.cpp
+
+static u32 CPU_RealtimeVICyclesPerLine(u64 now)
+{
+	float fill = 0.0f;
+	sVITrim = 0.0f;
+	if (AudioOutputCTR_GetRingFill(&fill))
+	{
+		sVITrim = kVIRingGain * (kVIRingSetpoint - fill);
+		if (sVITrim > kVIRingTrimMax) sVITrim = kVIRingTrimMax;
+		if (sVITrim < -kVIRingTrimMax) sVITrim = -kVIRingTrimMax;
+	}
+	FramerateLimiter_SetSpeedTrim(sVITrim);
+	if (sVIWorkStart != 0 && now > sVIWorkStart)
+	{
+		const float target = float( double(SYSCLOCK_ARM11 / FramerateLimiter_GetTvFrequencyHz()) / (1.0 + sVITrim) );
+		const float work = float(now - sVIWorkStart);	// real time this VI took, limiter sleep excluded
+		// The guest idles through some VIs (waiting for a graphics task,
+		// skipped in no time) and works through others, so the average over
+		// several VIs is what must meet the target: steering on single VIs
+		// pushed the period up on every idle VI and left the busy ones late
+		// (console: 59 VI/s with the trim asking for 63).
+		sVIWorkAvg = sVIWorkAvg == 0.0f ? work : sVIWorkAvg + 0.125f * (work - sVIWorkAvg);
+		float wanted = sVICyclesPerLine * (target / sVIWorkAvg);
+		if (wanted > kVIMaxCyclesPerLine)
+			wanted = kVIMaxCyclesPerLine;
+		sVICyclesPerLine += 0.25f * (wanted - sVICyclesPerLine);
+		if (sVICyclesPerLine < kVIMinCyclesPerLine)
+			sVICyclesPerLine = kVIMinCyclesPerLine;
+		if (sVICyclesPerLine > kVIMaxCyclesPerLine)
+			sVICyclesPerLine = kVIMaxCyclesPerLine;
+	}
+	return u32(sVICyclesPerLine);
+}
+
+u32 CPU_GetVICyclesPerLine()
+{
+	return CTR_REALTIME_VI ? u32(sVICyclesPerLine) : 1500;
+}
+
+float CPU_GetVITrim()
+{
+	return sVITrim;
+}
+
+u64 CPU_GetAICountHz(u64 nominal)
+{
+	if (!CTR_REALTIME_VI || VI_INTR_CYCLES < 100000)	// off, or no video mode yet
+		return nominal;
+	return u64(VI_INTR_CYCLES) * FramerateLimiter_GetTvFrequencyHz();
+}
