+// n64to3ds: screenshots for unattended runs.  If
+// sdmc:/3ds/n64to3ds-agent/screenshots holds a number of seconds (the file is
+// removed when read), the top screen is saved every that many seconds to
+// sdmc:/3ds/n64to3ds-agent/shot_NN.bmp, at most kMaxShots of them.
+static const char * kScreenshotFile = "sdmc:/3ds/n64to3ds-agent/screenshots";
+static const u32 kMaxShots = 30;
+static u64 sShotInterval = 0;	// system ticks, 0 = off
+static u64 sNextShot = 0;
+static u32 sShotCount = 0;
+
+static void SetupScreenshots()
+{
+	long seconds = 0;
+	{
+		std::ifstream in(kScreenshotFile);
+		if (!(in >> seconds))
+			return;
+	}
+	std::remove(kScreenshotFile);
+	if (seconds <= 0 || seconds > 3600)
+		return;
+	sShotInterval = u64(seconds) * u64(SYSCLOCK_ARM11);
+	sNextShot = svcGetSystemTick() + sShotInterval;
+	std::cout << "n64to3ds screenshots: every " << seconds << " s" << std::endl;
+}
+
+static void SaveTopScreen()
+{
+	u16 fb_width = 0, fb_height = 0;	// the framebuffer is 240 x 400, rotated
+	const u8 * fb = gfxGetFramebuffer(GFX_TOP, GFX_LEFT, &fb_width, &fb_height);
+	if (fb == nullptr || fb_width != 240 || fb_height != 400)
+		return;
+	const u32 width = 400, height = 240, image_bytes = width * height * 3;
+	// The whole file is built in memory and written with one call: on an Old
+	// 3DS each small SD write costs tens of milliseconds (240 row writes made
+	// one screenshot take ~20 s).  The framebuffer is read sequentially.
+	u8 * file_bytes = static_cast<u8 *>(malloc(54 + image_bytes));
+	if (file_bytes == nullptr)
+		return;
+	u8 * header = file_bytes;
+	memset(header, 0, 54);
+	header[0] = 'B';
+	header[1] = 'M';
+	auto put32 = [header](u32 offset, u32 value) { memcpy(header + offset, &value, 4); };
+	put32(2, 54 + image_bytes);
+	put32(10, 54);
+	put32(14, 40);
+	put32(18, width);
+	put32(22, height);	// bottom-up rows: BMP row 0 is the bottom of the screen
+	header[26] = 1;
+	header[28] = 24;
+	put32(34, image_bytes);
+	u8 * pixels = file_bytes + 54;
+	for (u32 x = 0; x < width; ++x)
+	{
+		const u8 * column = fb + x * 240 * 3;	// bottom of the screen first
+		for (u32 y = 0; y < height; ++y)
+			memcpy(pixels + (y * width + x) * 3, column + y * 3, 3);	// BGR, as BMP wants
+	}
+	char path[96];
+	snprintf(path, sizeof(path), "sdmc:/3ds/n64to3ds-agent/shot_%02lu.bmp", (unsigned long)sShotCount);
+	if (FILE * file = fopen(path, "wb"))
+	{
+		fwrite(file_bytes, 1, 54 + image_bytes, file);
+		fclose(file);
+		++sShotCount;
+	}
+	free(file_bytes);
+}
