+// n64to3ds: branch on the FPU condition bit (FPCSR_C), as R4300_BC1_BC1T/F do.
+void CCodeGeneratorARM::GenerateBC1( bool branch_if_true, const SBranchDetails * p_branch, CJumpLocation * p_branch_jump )
+{
+	#ifdef DAEDALUS_ENABLE_ASSERTS
+	DAEDALUS_ASSERT( p_branch != nullptr, "No branch details?" );
+	DAEDALUS_ASSERT( p_branch->Direct, "Indirect branch for BC1?" );
+	#endif
+	static_assert( FPCSR_C == 0x00800000, "MOV_IMM below encodes 0x02 ror 10" );
+
+	LDR(ArmReg_R0, ArmReg_R12, offsetof(SCPUState, FPUControl[31]._u32));
+	MOV_IMM(ArmReg_R1, 0x02, 0x5);
+	TST(ArmReg_R0, ArmReg_R1);
+
+	// The trace continues along the recorded direction; leave it when the
+	// condition now says otherwise.  NE means the condition bit is set.
+	const bool exit_if_set = p_branch->ConditionalBranchTaken != branch_if_true;
+	*p_branch_jump = BX_IMM(CCodeLabel(nullptr), exit_if_set ? NE : EQ);
+}
