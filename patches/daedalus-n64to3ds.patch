diff --git a/Source/Core/Memory_Read.inl b/Source/Core/Memory_Read.inl
index 474d3df..b798deb 100644
--- a/Source/Core/Memory_Read.inl
+++ b/Source/Core/Memory_Read.inl
@@ -140,13 +140,99 @@ static const void * Read_8440_844F( u32 address )
 	return temp;
