+
+// n64to3ds: instructions whose generators read only the low words of their
+// source registers and set the high word of their destination (or write
+// none), so a high word left pending by UpdateRegister can stay pending.
+// OR is listed for the move form only (rs or rt is r0), see GenerateOR.
+static bool KeepsPendingSignExtensions( OpCode op_code )
+{
+	switch( op_code.op )
+	{
+		case OP_J:		case OP_JAL:
+		case OP_BEQ:	case OP_BEQL:	case OP_BNE:	case OP_BNEL:
+		case OP_BLEZ:	case OP_BLEZL:	case OP_BGTZ:	case OP_BGTZL:
+		case OP_ADDI:	case OP_ADDIU:	case OP_SLTI:	case OP_SLTIU:
+		case OP_ANDI:	case OP_LUI:
+		case OP_LB:		case OP_LBU:	case OP_LH:		case OP_LHU:	case OP_LW:
+		case OP_SB:		case OP_SH:		case OP_SW:
+		case OP_LWC1:	case OP_LDC1:	case OP_SWC1:	case OP_SDC1:
+		case OP_COPRO1:		// MFC1, MTC1, CFC1, CTC1, BC1 and arithmetic; the rest is interpreted
+			return true;
+
+		case OP_REGIMM:
+			return op_code.regimm_op == RegImmOp_BLTZ || op_code.regimm_op == RegImmOp_BLTZL ||
+				   op_code.regimm_op == RegImmOp_BGEZ || op_code.regimm_op == RegImmOp_BGEZL;
+
+		case OP_SPECOP:
+			switch( op_code.spec_op )
+			{
+				case SpecOp_SLL:	case SpecOp_SRL:	case SpecOp_SRA:
+				case SpecOp_SLLV:	case SpecOp_SRLV:	case SpecOp_SRAV:
+				case SpecOp_ADD:	case SpecOp_ADDU:	case SpecOp_SUB:	case SpecOp_SUBU:
+				case SpecOp_SLT:	case SpecOp_SLTU:
+				case SpecOp_MULT:	case SpecOp_MULTU:	case SpecOp_DIV:	case SpecOp_DIVU:
+				case SpecOp_MFLO:	case SpecOp_MFHI:
+				case SpecOp_JR:		case SpecOp_JALR:
+					return true;
+				case SpecOp_OR:
+					return op_code.rs == N64Reg_R0 || op_code.rt == N64Reg_R0;
+				default:
+					return false;
+			}
+
+		default:
+			return false;
+	}
+}
