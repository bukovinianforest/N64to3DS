+//*****************************************************************************
+// If fragments overlap dynarec has to start all over which is very costly
+//*****************************************************************************
+void  CPU_InvalidateICacheRange( u32 address, u32 length )
+{
+	N64_PHASE_SCOPE(PHASE_ICACHE);
+	N64_COUNT(gN64ICacheInvalidations);
+#ifdef N64TO3DS_AOT
+	// AOT blocks are validated against resident RDRAM.  Any write that can
+	// change instruction bytes must force revalidation, even if it does not
+	// overlap a Dynarec fragment.
+	n64to3ds::AOTRuntime_InvalidateRange( address, length );
+#endif
+
+	if( gFragmentCache.ShouldInvalidateOnWrite( address, length ) )
+	{
+#ifndef DAEDALUS_SILENT
+		printf( "Write to %08x (%d bytes) overlaps fragment cache entries\n", address, length );
+#endif
+		CPU_ResetFragmentCache();
+	}
+}
