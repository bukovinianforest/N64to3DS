+// Every 64 VIs (about a second; VIs keep real time, see Core/CPU.cpp).
+static void OnVblInterval(void *)
+{
+	const u64 now = svcGetSystemTick();
+	if (sShotInterval != 0 && now >= sNextShot && sShotCount < kMaxShots)
+	{
+		SaveTopScreen();
+		sNextShot = now + sShotInterval;
+	}
+	UpdateCodeDump(now);
+	static u64 last_diag = 0;
+	if (last_diag == 0)
+		last_diag = now;
+	if (now - last_diag >= 10 * u64(SYSCLOCK_ARM11))
+	{
+		LogDiagWindow(now - last_diag, sFramesSinceDiag);
+		last_diag = now;
+		sFramesSinceDiag = 0;
+	}
+	if (sLastEndOfFrameTick != 0 && now - sLastEndOfFrameTick > u64(SYSCLOCK_ARM11))
+	{
+		// No frame ended for a second.  aptMainLoop may suspend the
+		// application, so the core 1 graphics thread must not be using the
+		// GPU meanwhile.
+		GraphicsThreadCTR_Wait();
+		PollSystem();
+		sLastEndOfFrameTick = now;
+	}
+}
