+//*****************************************************************************
+// n64to3ds: on Old 3DS each romfs read costs ~15 ms almost independently of
+// its 2 KB size, and one PI DMA can miss dozens of consecutive chunks.  Load
+// up to max_chunks consecutive uncached chunks, starting at chunk_map_idx,
+// with one ReadChunk and install them in the same LRU order the one-chunk
+// path would.  Returns INVALID_IDX, having changed nothing, when fewer than
+// two chunks qualify or the read fails; the caller then takes that path.
+//*****************************************************************************
+ROMFileCache::CacheIdx	ROMFileCache::LoadChunkRun( u32 chunk_map_idx, u32 max_chunks )
+{
+	if( mpRunBuffer == nullptr )
+	{
+		return INVALID_IDX;
+	}
+
+	const u64	rom_size( mpROMFile->GetRomSize() );
+	const u32	limit( std::min( max_chunks, MAX_RUN_BYTES / CHUNK_SIZE ) );
+	u32			count( 0 );
+	while( count < limit )
+	{
+		const u32	map_idx( chunk_map_idx + count );
+		// Stop at a cached chunk, and leave a partial last chunk to the
+		// one-chunk path: its short read fails there and must stay so.
+		if( map_idx >= mChunkMapEntries || mpChunkMap[ map_idx ] != INVALID_IDX ||
+			u64( map_idx + 1 ) * CHUNK_SIZE > rom_size )
+		{
+			break;
+		}
+		++count;
+	}
+	if( count < 2 )
+	{
+		return INVALID_IDX;
+	}
+
+	if( !mpROMFile->ReadChunk( chunk_map_idx * CHUNK_SIZE, mpRunBuffer, count * CHUNK_SIZE ) )
+	{
+		return INVALID_IDX;
+	}
+
+	CacheIdx	first_idx( INVALID_IDX );
+	for( u32 i = 0; i < count; ++i )
+	{
+		// Same victim choice as GetCacheIndex.  Chunks installed earlier in
+		// this run are the most recent, so they are never chosen here.
+		CacheIdx	selected_idx( 0 );
+		u32			oldest_timestamp( mpChunkInfo[ 0 ].LastUseIdx );
+		for(CacheIdx j = 1; j < CACHE_SIZE; ++j)
+		{
+			u32		timestamp( mpChunkInfo[ j ].LastUseIdx );
+			if(timestamp < oldest_timestamp)
+			{
+				oldest_timestamp = timestamp;
+				selected_idx = j;
+			}
+		}
+
+		PurgeChunk( selected_idx );
+
+		SChunkInfo &		chunk_info( mpChunkInfo[ selected_idx ] );
+		chunk_info.StartOffset = ( chunk_map_idx + i ) * CHUNK_SIZE;
+		chunk_info.LastUseIdx = ++mMRUIdx;
+		mpChunkMap[ chunk_map_idx + i ] = selected_idx;
+
+		memcpy( mpStorage + selected_idx * CHUNK_SIZE, mpRunBuffer + i * CHUNK_SIZE, CHUNK_SIZE );
+
+		if( i == 0 )
+		{
+			first_idx = selected_idx;
+		}
+	}
+	return first_idx;
+}
