+// n64to3ds: AI DMA FIFO model.
+//
+// Upstream Daedalus returned the last written AI_LEN forever.  libultra's
+// audio code reads AI_LEN to see how much of the current buffer is still
+// playing and generates only the missing samples, so a length that never
+// counts down made games produce too little audio (HM64: about 14% short,
+// heard as choppy sound).  Real hardware has a two-entry DMA FIFO: AI_LEN
+// reads the bytes left in the playing buffer, and AI_STATUS reports BUSY and
+// FULL.  Playback is advanced from the CP0 Count register (46.875 MHz on
+// hardware) at the rate set in AI_DACRATE.
+namespace
+{
+	constexpr u64 kAICountHz = 46875000;
+	u32 gAICurrentBytes = 0;	// bytes left in the playing buffer
+	u32 gAINextBytes = 0;		// queued buffer, 0 if the FIFO has one entry
+	u32 gAILastCount = 0;
+	u64 gAIFraction = 0;		// sub-byte remainder, in byte * kAICountHz units
+
+	void AI_AdvanceModel()
+	{
+		const u32 now = gCPUState.CPUControl[C0_COUNT]._u32;
+		const u32 elapsed = now - gAILastCount;
+		gAILastCount = now;
+		if (gAICurrentBytes == 0)
+		{
+			gAIFraction = 0;
+			return;
+		}
+
+		const u32 dacrate = *(u32 *)((u8 *)g_pMemoryBuffers[MEM_AI_REG] + 0x10) & 0x3FFF;
+		const u64 clock = g_ROM.TvType ? VI_NTSC_CLOCK : VI_PAL_CLOCK;
+		const u64 bytes_per_second = (clock / (dacrate + 1)) * 4;	// 16-bit stereo
+		gAIFraction += u64(elapsed) * bytes_per_second;
+		u64 consumed = gAIFraction / kAICountHz;
+		gAIFraction %= kAICountHz;
+
+		while (consumed != 0 && gAICurrentBytes != 0)
+		{
+			if (consumed < gAICurrentBytes)
+			{
+				gAICurrentBytes -= u32(consumed);
+				consumed = 0;
+			}
+			else
+			{
+				consumed -= gAICurrentBytes;
+				gAICurrentBytes = gAINextBytes;
+				gAINextBytes = 0;
+			}
+		}
+		if (gAICurrentBytes == 0)
+			gAIFraction = 0;
+	}
+}
+
+void AI_ResetModel()
+{
+	gAICurrentBytes = 0;
+	gAINextBytes = 0;
+	gAILastCount = gCPUState.CPUControl[C0_COUNT]._u32;
+	gAIFraction = 0;
+}
+
+void AI_QueueBuffer(u32 length)
+{
+	AI_AdvanceModel();
+	length &= 0x3FFF8;	// LS 3 bits ignored, 18-bit length
+	if (length == 0)
