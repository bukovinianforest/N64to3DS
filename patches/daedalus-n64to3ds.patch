diff --git a/Source/Utility/N64Phase.h b/Source/Utility/N64Phase.h
new file mode 100644
index 0000000..51cca7b
--- /dev/null
+++ b/Source/Utility/N64Phase.h
@@ -0,0 +1,197 @@
+#pragma once
+
+#include "Base/Types.h"
+
+// n64to3ds: where core 0 spends its time, for the on-console profiler in
+// SysCTR/main.cpp.  Code marks coarse regions with N64_PHASE_SCOPE; when a
+// profiled run is requested, a sampling thread on core 0 counts which phase
+// the CPU thread is in about a thousand times a second.  Unprofiled runs pay
+// one byte store per region boundary.  The event counters are plain
+// increments and are always logged.
+
+#ifdef DAEDALUS_CTR
+
+enum EN64Phase : u8
+{
+	PHASE_OTHER,		// emulator bookkeeping, event handling
+	PHASE_JIT,			// running dynarec fragments
+	PHASE_INTERP,		// interpreting instructions
+	PHASE_TRACE,		// interpreting while recording a dynarec trace
+	PHASE_COMPILE,		// assembling a fragment
+	PHASE_TLB,			// TLB-mapped memory access (address translation)
+	PHASE_GFX,			// graphics task work on core 0 (task start and end)
+	PHASE_GFX_WAIT,		// waiting for the core 1 graphics thread
+	PHASE_AUDIO,		// audio work on core 0 (task start, AI buffer copy)
+	PHASE_AUDIO_WAIT,	// waiting for the core 1 audio thread or the output ring
+	PHASE_LIMITER,		// frame limiter sleep
+	PHASE_PRESENT,		// swapping the 3DS framebuffers
+	PHASE_DMA,			// PI DMA (cartridge to RDRAM)
+	PHASE_AOT,			// AOT dispatcher and AOT blocks
+	PHASE_DISPATCH,		// dynarec fragment lookup, cache clears, trace start
+	PHASE_EVENTS,		// CPU_CheckStuffToDo: exceptions, interrupts, core switches
+	PHASE_ICACHE,		// instruction cache invalidation (fragments, AOT)
+	PHASE_COUNT
+};
+
+inline volatile u8 gN64Phase = PHASE_OTHER;
+
+inline u32 gN64TlbAccesses = 0;			// ReadMapped / WriteValueMapped calls
+inline u32 gN64FragmentRuns = 0;		// dynarec fragment entries
+inline u32 gN64FragmentCompiles = 0;	// fragments assembled
+inline u32 gN64FragmentResets = 0;		// fragment cache reset requests
+inline u32 gN64InterpOps = 0;			// instructions interpreted (incl. tracing)
+inline u32 gN64TraceAborts = 0;			// traces dropped because an interrupt or exception came first
+inline u32 gN64Exceptions = 0;			// TLB exceptions raised
+inline u32 gN64ICacheInvalidations = 0;	// CPU_InvalidateICacheRange calls
+inline u32 gN64AotBlocks = 0;			// AOT blocks executed
+inline u32 gN64IndirectExits = 0;		// IndirectExitMap_Lookup calls (indirect exits that missed gN64IndirectTable)
+inline u32 gN64EventCounts[8];			// CPU_HANDLE_COUNT_INTERRUPT by ECPUEventType
+inline u32 gN64SkipToEvent = 0;			// CPU_SkipToNextEvent calls (idle loops)
+inline u32 gN64SkippedCycles = 0;		// COUNT cycles those calls skipped
+// Finer position inside PHASE_EVENTS for the sampler: the event type being
+// handled (1..7), 0x11.. for steps of the VBL handler, 0x20 for
+// CPU_CheckStuffToDo.  Inside PHASE_COMPILE: 0x30 trace analysis, 0x31
+// fragment setup, 0x32 code for the trace, 0x33 exit handlers, 0x34
+// finalise (exception handlers, literal pools, cache maintenance), 0x35
+// inserting and linking the fragment.
+inline volatile u8 gN64SubPhase = 0;
+// Core 1 busy time in system ticks, written by the worker threads.
+inline volatile u64 gN64AudioThreadTicks = 0;	// Audio_Ucode on the audio thread
+inline volatile u64 gN64GfxThreadTicks = 0;		// DLParser_RenderTask on the graphics thread
+// Profiled runs only: audio thread ticks per audio list command (index =
+// command byte & 31) and the ABI table in use (1, 2, 3, ... 0 = unknown).
+inline u64 gN64AudioCmdTicks[32];
+inline u32 gN64AudioCmdCounts[32];
+inline volatile u32 gN64AudioAbi = 0;
+
+struct N64PhaseScope
+{
+	u8 previous;
+	explicit N64PhaseScope(u8 phase) : previous(gN64Phase) { gN64Phase = phase; }
+	~N64PhaseScope() { gN64Phase = previous; }
+	N64PhaseScope(const N64PhaseScope &) = delete;
+	N64PhaseScope & operator=(const N64PhaseScope &) = delete;
+};
+
+// What core 1 is doing, for a second sampler thread on core 1 (profiled
+// runs).  The graphics and audio threads mark their work with
+// N64_CORE1_SCOPE; the audio thread preempts the graphics thread and
+// restores its phase when its scope ends.
+enum EN64Core1Phase : u8
+{
+	C1_IDLE,			// neither thread is working (or the system uses the core)
+	C1_GFX_DL,			// display list parsing and RDP state (default in a graphics task)
+	C1_GFX_VERTEX,		// vertex transform and lighting (SetNewVertexInfo*)
+	C1_GFX_TRIS,		// triangle batches: index and vertex preparation (FlushTris)
+	C1_GFX_DRAW,		// blend setup and picaGL draw calls (RendererCTR)
+	C1_GFX_RECT,		// TexRect / FillRect
+	C1_GFX_TEXTURE,		// texture cache lookups (UpdateTileSnapshots)
+	C1_GFX_TEXHASH,		// texture content hashing
+	C1_GFX_TEXCONV,		// texture conversion to the native format
+	C1_GFX_TEXUPLOAD,	// glTexImage2D
+	C1_GFX_FINISH,		// end of task: read ranges, cache maintenance
+	C1_AUDIO,			// audio list (Audio_Ucode)
+	C1_GFX_BLEND,		// combiner mode lookup (RendererCTR::LookupBlendState)
+	C1_GFX_COMBINE,		// combiner emulation per draw (RenderUsingRenderSettings)
+	C1_GFX_VCOPY,		// vertex copy into the GL arrays (DrawPrimitives)
+	C1_GFX_PICAGL,		// inside picaGL (GL calls that reach it, deferred draws)
+	C1_GFX_PREPARE,		// PrepareTrisUnclipped: triangle vertices into the draw buffer
+	C1_PHASE_COUNT
+};
+
+inline volatile u8 gN64Core1Phase = C1_IDLE;
+// The GBI command the graphics thread is executing (HLEGraphics/DLParser.cpp),
+// sampled together with gN64Core1Phase.
+inline volatile u8 gN64Core1Cmd = 0;
+
+// Applications get thread priorities 0x18 and below (higher numbers), so in
+// profiled runs the audio and graphics threads drop one step to let the core
+// 1 sampler (0x18) preempt them.  Set before either thread is created.
+inline u32 gN64Core1PriorityShift = 0;
+
+// Set by the core 1 graphics and audio threads: code they share with the
+// CPU thread (the GL cache, for one) must not touch gN64Core1Phase from core 0.
+inline thread_local bool gN64OnCore1 = false;
+
+struct N64Core1Scope
+{
+	u8 previous;
+	const bool active;
+	explicit N64Core1Scope(u8 phase) : previous(gN64Core1Phase), active(gN64OnCore1) { if (active) gN64Core1Phase = phase; }
+	~N64Core1Scope() { if (active) gN64Core1Phase = previous; }
+	N64Core1Scope(const N64Core1Scope &) = delete;
+	N64Core1Scope & operator=(const N64Core1Scope &) = delete;
+};
+
+// Stall reports (SysCTR/main.cpp): what happened during a long frame.
+inline u32 gN64CodeFlushes = 0;				// dynarec cache maintenance (new block or patched link)
+inline u32 gN64TextureUpdates = 0;				// textures converted and uploaded (core 1)
+inline u32 gN64TextureTexels = 0;				// texels in them
+inline volatile u64 gN64GfxTaskMaxTicks = 0;	// longest graphics task since the CPU thread reset it
+inline volatile u32 gN64GfxFlushes = 0;			// BaseRenderer::FlushTris calls with vertices
+inline volatile u32 gN64GfxFlushVerts = 0;		// vertices they drew
+inline volatile u32 gN64SaveWrites = 0;			// save files written (Core/Save.cpp writer thread)
+inline volatile u64 gN64SaveWriteTicks = 0;		// time spent writing them
+
+// Profiled runs only: dynarec fragments count each instruction they hand to
+// the interpreter (CCodeGeneratorARM::GenerateGenericR4300), per kind of
+// instruction (the opcode with its register fields cleared).
+inline bool gN64ProfileGenericOps = false;
+struct N64OpCount { u32 kind; u32 count; };
+inline N64OpCount gN64GenericOps[96];
+
+inline u32 N64_OpKind(u32 op)
+{
+	const u32 major = op >> 26;
+	if (major == 0)
+		return op & 0xFC00003F;			// SPECIAL: function field
+	if (major == 1)
+		return op & 0xFC1F0000;			// REGIMM: rt selects the op
+	if (major == 0x10 || major == 0x11 || major == 0x12)
+	{
+		const u32 fmt = (op >> 21) & 0x1F;
+		return fmt >= 0x10 ? (op & 0xFFE0003F) : (op & 0xFFE00000);
+	}
+	return op & 0xFC000000;
+}
+
+// Counter for an instruction kind, or nullptr when the table is full.
+inline u32 * N64_GenericOpCounter(u32 op)
+{
+	const u32 kind = N64_OpKind(op);
+	for (N64OpCount & entry : gN64GenericOps)
+	{
+		if (entry.count == 0 && entry.kind == 0 && kind != 0)
+		{
+			entry.kind = kind;
+			return &entry.count;
+		}
+		if (entry.kind == kind)
+			return &entry.count;
+	}
+	return nullptr;
+}
+
+// Console A/B runs: dynarec optimisations switched off for the whole run
+// (sdmc:/3ds/n64to3ds-agent/dynarec_off holds the mask, read at startup).
+enum : u32
+{
+	N64_DYNAREC_DELAY_FLAGS	= 1,	// keep every delay-slot Delay store
+	N64_DYNAREC_EAGER_SIGN	= 2,	// store high words as soon as they are written
+	N64_DYNAREC_LIKELY_EXIT	= 4,	// exit into the delay slot of an untaken likely branch
+	N64_DYNAREC_CALL_EXIT	= 8,	// direct exits call _DirectExitCheckNoDelay
+	N64_DYNAREC_SLOW_INDIRECT = 16,	// indirect exits use _IndirectExitCheck
+};
+inline u32 gN64DynarecDisable = 0;
+
+#define N64_PHASE_SCOPE(phase)	N64PhaseScope n64_phase_scope(phase)
+#define N64_CORE1_SCOPE(phase)	N64Core1Scope n64_core1_scope(phase)
+#define N64_COUNT(counter)		(++(counter))
+
+#else
+
+#define N64_PHASE_SCOPE(phase)	((void)0)
+#define N64_CORE1_SCOPE(phase)	((void)0)
+#define N64_COUNT(counter)		((void)0)
+
+#endif
