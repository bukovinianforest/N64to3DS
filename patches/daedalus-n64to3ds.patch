diff --git a/Source/Input/CTR/InputManagerCTR.cpp b/Source/Input/CTR/InputManagerCTR.cpp
index 78970d6..d19b21b 100644
--- a/Source/Input/CTR/InputManagerCTR.cpp
+++ b/Source/Input/CTR/InputManagerCTR.cpp
@@ -37,6 +37,109 @@ Foundation, Inc., 59 Temple Place - Suite 330, Boston, MA  02111-1307, USA.
 #include "Utility/Stream.h"
 #include "Debug/Synchroniser.h"
 
+#include <fstream>
+#include <iostream>
+#include <sstream>
+#include <string>
+
+// n64to3ds: scripted 3DS input for unattended hardware runs.  If
+// sdmc:/3ds/n64to3ds-agent/inputs exists when the game starts (it is removed
+// when read), each line "<start s> <duration s> <KEY[+KEY...]|STICK dx dy>"
+// holds those keys, or the circle pad position, for that time after the
+// game started; '#' starts a comment.  The keys go through the normal
+// controller mapping, as if pressed.
+namespace
+{
+	struct ScriptedInput
+	{
+		u64 start, end;	// system ticks
+		u32 keys;
+		s16 dx, dy;
+		bool stick;
+	};
+	std::vector<ScriptedInput> sScript;
+
+	u32 KeyFromName(const std::string & name)
+	{
+		static const struct { const char * name; u32 key; } kKeys[] = {
+			{ "A", KEY_A }, { "B", KEY_B }, { "X", KEY_X }, { "Y", KEY_Y },
+			{ "L", KEY_L }, { "R", KEY_R }, { "ZL", KEY_ZL }, { "ZR", KEY_ZR },
+			{ "START", KEY_START }, { "SELECT", KEY_SELECT },
+			{ "UP", KEY_DUP }, { "DOWN", KEY_DDOWN }, { "LEFT", KEY_DLEFT }, { "RIGHT", KEY_DRIGHT },
+			{ "CUP", KEY_CSTICK_UP }, { "CDOWN", KEY_CSTICK_DOWN }, { "CLEFT", KEY_CSTICK_LEFT }, { "CRIGHT", KEY_CSTICK_RIGHT },
+		};
+		for (const auto & key : kKeys)
+			if (name == key.name)
+				return key.key;
+		return 0;
+	}
+}
+
+void InputScriptCTR_Load(const char * path)
+{
+	std::ifstream in(path);
+	if (!in)
+		return;
+	const u64 now = svcGetSystemTick();
+	std::string line;
+	u32 count = 0;
+	while (std::getline(in, line))
+	{
+		const size_t comment = line.find('#');
+		if (comment != std::string::npos)
+			line.resize(comment);
+		std::istringstream fields(line);
+		double start = 0.0, duration = 0.0;
+		std::string what;
+		if (!(fields >> start >> duration >> what) || start < 0.0 || duration <= 0.0)
+			continue;
+		ScriptedInput input = { now + u64(start * SYSCLOCK_ARM11), now + u64((start + duration) * SYSCLOCK_ARM11), 0, 0, 0, false };
+		if (what == "STICK")
+		{
+			int dx = 0, dy = 0;
+			if (!(fields >> dx >> dy))
+				continue;
+			input.stick = true;
+			input.dx = s16(dx);
+			input.dy = s16(dy);
+		}
+		else
+		{
+			std::stringstream names(what);
+			std::string name;
+			while (std::getline(names, name, '+'))
+				input.keys |= KeyFromName(name);
+			if (input.keys == 0)
+				continue;
+		}
+		sScript.push_back(input);
+		++count;
+	}
+	in.close();
+	std::remove(path);
+	std::cout << "n64to3ds inputs: " << count << " scripted inputs" << std::endl;	// to daedalus.log
+}
+
+static u32 InputScriptCTR_Apply(circlePosition & pad)
+{
+	if (sScript.empty())
+		return 0;
+	const u64 now = svcGetSystemTick();
+	u32 keys = 0;
+	for (const ScriptedInput & input : sScript)
+	{
+		if (now < input.start || now >= input.end)
+			continue;
+		if (input.stick)
+		{
+			pad.dx = input.dx;
+			pad.dy = input.dy;
+		}
+		keys |= input.keys;
+	}
+	return keys;
+}
+
 extern bool isN3DS;
 
