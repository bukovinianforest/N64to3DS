+// Replace a save file without truncating the previous version in place.  The
+// new contents are written to a sibling temporary file, flushed, and renamed
+// over the destination.  FAT implementations do not always replace an
+// existing destination with rename(), so fall back to remove+rename; that
+// still leaves the old file intact if writing the temporary file fails.
+static bool WriteFileAtomically( const std::filesystem::path & path, const u8 * data, size_t size )
+{
+	std::filesystem::path temp_path = path;
+	temp_path += ".tmp";
+
+	{
+		std::ofstream fp( temp_path, std::ios::binary | std::ios::trunc );
+		if( !fp.is_open() )
+			return false;
+
+		fp.write( reinterpret_cast<const char *>( data ), static_cast<std::streamsize>( size ) );
+		fp.flush();
+		if( !fp )
+		{
+			fp.close();
+			std::error_code ignored;
+			std::filesystem::remove( temp_path, ignored );
+			return false;
+		}
+	}
