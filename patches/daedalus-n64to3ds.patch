+// n64to3ds: proven poll-loop detection.
+//
+// A trace that starts at a loop head and ends with a conditional branch back
+// to that head (plus its delay slot) is a "poll loop" when one iteration has
+// no effect other than re-reading constant RDRAM addresses: no stores, no
+// calls, no coprocessor or HI/LO access, no MMIO, and no register carried from
+// one iteration to the next.  Each further iteration then produces exactly the
+// same state until something outside the CPU changes RDRAM, and in Daedalus
+// that only happens when a scheduled event is processed (interrupts, DMA
+// completion, RSP tasks).  Skipping the remaining iterations to the next event
+// is therefore exact, in the same way Daedalus already skips "b ." loops.
+//
+// The check runs on the instructions that were actually executed while the
+// trace was recorded, so it never treats data as code, and the fragment cache
+// already invalidates the fragment if those bytes change.  Anything that does
+// not match the pattern exactly is compiled as before.
+constexpr u32 kMaxPollLoopInstructions = 8;
+
+bool IsRdramAddress(u32 address, u32 size)
+{
+	const u32 segment = address & 0xE0000000u;
+	if (segment != 0x80000000u && segment != 0xA0000000u)
+		return false;
+	const u32 physical = address & 0x1FFFFFFFu;
+	return physical + size <= gRamSize && (address & (size - 1)) == 0;
+}
+
+bool IsProvenPollLoop(const std::vector< STraceEntry > & trace,
+					  const std::vector< SBranchDetails > & branch_details,
+					  u32 exit_address)
+{
+	const u32 count = trace.size();
+	if (count < 2 || count > kMaxPollLoopInstructions)
+		return false;
+	const u32 head = trace[0].Address;
+	if (exit_address != head)
+		return false;
+	for (u32 i = 0; i < count; ++i)
+	{
+		if (trace[i].Address != head + 4 * i)
+			return false;
+	}
+
+	// Exactly one branch: the second-to-last entry, a direct conditional
+	// non-likely branch that was taken back to the head; the last entry is
+	// its delay slot.
+	if (branch_details.size() != 1)
+		return false;
+	const SBranchDetails & branch = branch_details[0];
+	const STraceEntry & branch_entry = trace[count - 2];
+	if (branch_entry.BranchIdx != 0 || !branch.Direct || branch.Likely || branch.Eret ||
+		!branch.ConditionalBranchTaken || branch.DelaySlotTraceIndex != s32(count - 1) ||
+		!trace[count - 1].BranchDelaySlot)
+	{
+		return false;
+	}
+
+	bool written[32] = {};
+	bool known[32] = {};
+	u32 value[32] = {};
+	known[0] = true;
+	bool any_load = false;
+
+	auto source_ok = [&](u32 reg, u32 index) -> bool
+	{
+		if (reg == 0 || written[reg])
+			return true;
+		// Not yet written in this iteration: it must not be written later
+		// either, otherwise the loop carries state between iterations.
+		for (u32 j = index; j < count; ++j)
+		{
+			const u32 w = trace[j].OpCode._u32;
+			const u32 op = w >> 26;
+			u32 dest = 0;
+			if (op == 0)
+				dest = (w >> 11) & 31;
+			else if (op != 1 && op != 4 && op != 5 && op != 6 && op != 7)
+				dest = (w >> 16) & 31;
+			if (dest == reg)
+				return false;
+		}
+		return true;
+	};
+	auto write = [&](u32 reg, bool is_known, u32 v)
+	{
+		if (reg == 0)
+			return;
+		written[reg] = true;
+		known[reg] = is_known;
+		value[reg] = v;
+	};
+
+	for (u32 i = 0; i < count; ++i)
+	{
+		const u32 w = trace[i].OpCode._u32;
+		const u32 op = w >> 26;
+		const u32 rs = (w >> 21) & 31;
+		const u32 rt = (w >> 16) & 31;
+		const u32 rd = (w >> 11) & 31;
+		const u32 sa = (w >> 6) & 31;
+		const u32 imm = w & 0xFFFF;
+		const u32 simm = u32(s32(s16(imm)));
+
+		if (i == count - 2)
+		{
+			// The loop branch itself.
+			bool cond_ok = false;
+			if (op == OP_BEQ || op == OP_BNE)
+				cond_ok = source_ok(rs, i) && source_ok(rt, i);
+			else if ((op == OP_BLEZ || op == OP_BGTZ) && rt == 0)
+				cond_ok = source_ok(rs, i);
+			else if (op == OP_REGIMM && (rt == RegImmOp_BLTZ || rt == RegImmOp_BGEZ))
+				cond_ok = source_ok(rs, i);
+			if (!cond_ok)
+				return false;
+			const u32 target = head + 4 * i + 4 + (simm << 2);
+			if (target != head)
+				return false;
+			continue;
+		}
+
+		if (w == 0)
+			continue;	// nop
+
+		switch (op)
+		{
+		case OP_LUI:
+			write(rt, true, imm << 16);
+			break;
+		case OP_ADDIU:
+		case OP_ORI:
+		case OP_ANDI:
+		case OP_XORI:
+		case OP_SLTI:
+		case OP_SLTIU:
+		{
+			if (!source_ok(rs, i))
+				return false;
+			bool k = known[rs] && (rs == 0 || written[rs]);
+			u32 v = 0;
+			if (k)
+			{
+				const u32 a = value[rs];
+				switch (op)
+				{
+				case OP_ADDIU: v = a + simm; break;
+				case OP_ORI:   v = a | imm; break;
+				case OP_ANDI:  v = a & imm; break;
+				case OP_XORI:  v = a ^ imm; break;
+				case OP_SLTI:  v = s32(a) < s32(simm) ? 1 : 0; break;
+				default:       v = a < simm ? 1 : 0; break;
+				}
+			}
+			write(rt, k, v);
+			break;
+		}
+		case OP_LB:
+		case OP_LBU:
+		case OP_LH:
+		case OP_LHU:
+		case OP_LW:
+		{
+			// The address must be a constant built inside this iteration and
+			// must be plain RDRAM: MMIO reads (VI_CURRENT, SP_STATUS, ...) can
+			// change without a scheduled event.
+			if (rs == 0 || !written[rs] || !known[rs])
+				return false;
+			const u32 size = (op == OP_LW) ? 4 : (op == OP_LH || op == OP_LHU) ? 2 : 1;
+			if (!IsRdramAddress(value[rs] + simm, size))
+				return false;
+			write(rt, false, 0);
+			any_load = true;
+			break;
+		}
+		case OP_SPECOP:
+		{
+			const u32 f = w & 63;
+			switch (f)
+			{
+			case SpecOp_SLL:
+			case SpecOp_SRL:
+			case SpecOp_SRA:
+				if (!source_ok(rt, i))
+					return false;
+				write(rd, false, 0);
+				break;
+			case SpecOp_ADDU:
+			case SpecOp_SUBU:
+			case SpecOp_AND:
+			case SpecOp_OR:
+			case SpecOp_XOR:
+			case SpecOp_NOR:
+			case SpecOp_SLT:
+			case SpecOp_SLTU:
+				if (sa != 0 || !source_ok(rs, i) || !source_ok(rt, i))
+					return false;
+				write(rd, false, 0);
+				break;
+			default:
+				return false;
+			}
+			break;
+		}
+		default:
+			return false;
+		}
+	}
+	// A loop that reads no memory and does not branch to itself
+	// unconditionally could only exit via its own registers; leave it alone.
+	return any_load;
+}
+}
