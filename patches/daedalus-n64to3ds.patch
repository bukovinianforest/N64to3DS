+				"n64to3ds stall: ms=%.0f vis=%lu frag_compiles=%lu frag_resets=%lu code_flushes=%lu interp_ops=%lu"
+				" textures=%lu texels=%lu gfx_wait_ms=%.0f audio_wait_ms=%.0f gfx_task_max_ms=%.1f pc=0x%08lx",
+				double(now - last) * tick_ms, (unsigned long)(vi - last_vi),
+				(unsigned long)(gN64FragmentCompiles - last_compiles), (unsigned long)(gN64FragmentResets - last_resets),
+				(unsigned long)(gN64CodeFlushes - last_flushes), (unsigned long)(gN64InterpOps - last_interp),
