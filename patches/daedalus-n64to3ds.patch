+// n64to3ds: console A/B runs.  sdmc:/3ds/n64to3ds-agent/dynarec_off holds
+// a mask of dynarec optimisations to switch off (N64_DYNAREC_* in
+// Utility/N64Phase.h); the file is removed when read.
+static void SetupDynarecSwitches()
+{
+	const char * path = "sdmc:/3ds/n64to3ds-agent/dynarec_off";
+	unsigned long mask = 0;
+	{
+		std::ifstream in(path);
