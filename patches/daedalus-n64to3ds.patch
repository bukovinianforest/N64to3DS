index 0000000..1320e9f
--- /dev/null
+++ b/Source/HLEAudio/EnvMixerFast.h
@@ -0,0 +1,338 @@
+#pragma once
+
+// n64to3ds: ARM11-friendly main loops of the ENVMIXER audio commands, the
+// costliest audio work on an Old 3DS (about half of the audio time in
+// GoldenEye with ABI1, a third or more in Mario Kart 64 with ABI2).
+//
+// ABI1 (AudioHLEState::EnvMixer):
+//
+// The original loop visits element ptr ^ 1 for ptr = 0, 1, 2, ..., so the
+// elements come in pairs that share one 32-bit word of each buffer: the high
+// halfword first, then the low one (little-endian host).  Here every word is
+// read and written once instead of each halfword separately, the aux buffers
+// are a template parameter instead of a per-sample test, and saturation is a
+// single SSAT.  Groups of 8 samples in which neither ramp moves (the volume
+// step is 0, the usual case once a voice has reached its target) compute the
+// gains once.  The arithmetic and its order are unchanged, so the output and
+// the saved ramp state are bit-identical to the original loop; a host test
+// compares both on random inputs.
+//
+// EnvMixer1FastApplies() must hold: every buffer 4-byte aligned, and any two
+// buffers either the same or not overlapping.  Otherwise the caller keeps the
+// original loop.
+
+#include "Base/Types.h"
+
+#include <cstring>
+
+namespace n64to3ds_audio
+{
+
+inline s32 EnvSat16(s32 x)
+{
+#if defined(__arm__) && defined(__ARM_ARCH) && __ARM_ARCH >= 6
+	s32 r;
+	asm("ssat %0, #16, %1" : "=r"(r) : "r"(x));
+	return r;
+#else
+	return x > 32767 ? 32767 : (x < -32768 ? -32768 : x);
+#endif
+}
+
+inline u32 EnvLoad(const u8 * p)			{ u32 v; memcpy(&v, p, 4); return v; }
+inline void EnvStore(u8 * p, u32 v)			{ memcpy(p, &v, 4); }
+inline s32 EnvMix(s32 acc, s32 in, s32 gain)	{ return EnvSat16(acc + ((in * gain + 0x4000) >> 15)); }
+
+// ARMv6 DSP/SIMD instructions, with exact scalar equivalents for the host
+// test: SMULWB/SMULWT give bits 47..16 of a 32 x 16-bit signed product,
+// SMLABB/SMLATT add a 16 x 16-bit product of the low/high halfwords,
+// QADD16 adds both halfwords with signed saturation.
+#if defined(__arm__) && defined(__ARM_ARCH) && __ARM_ARCH >= 6
+inline s32 EnvSmulwb(s32 a, u32 b) { s32 r; asm("smulwb %0, %1, %2" : "=r"(r) : "r"(a), "r"(b)); return r; }
+inline s32 EnvSmulwt(s32 a, u32 b) { s32 r; asm("smulwt %0, %1, %2" : "=r"(r) : "r"(a), "r"(b)); return r; }
+inline u32 EnvQadd16(u32 a, u32 b) { u32 r; asm("qadd16 %0, %1, %2" : "=r"(r) : "r"(a), "r"(b)); return r; }
+inline s32 EnvSmlabb(u32 a, u32 b, s32 acc) { s32 r; asm("smlabb %0, %1, %2, %3" : "=r"(r) : "r"(a), "r"(b), "r"(acc)); return r; }
+inline s32 EnvSmlatt(u32 a, u32 b, s32 acc) { s32 r; asm("smlatt %0, %1, %2, %3" : "=r"(r) : "r"(a), "r"(b), "r"(acc)); return r; }
+#else
+inline s32 EnvSmulwb(s32 a, u32 b) { return (s32)(((s64)a * (s16)b) >> 16); }
+inline s32 EnvSmulwt(s32 a, u32 b) { return (s32)(((s64)a * (s16)(b >> 16)) >> 16); }
+inline u32 EnvQadd16(u32 a, u32 b)
+{
+	return ((u32)(u16)EnvSat16((s16)(a >> 16) + (s16)(b >> 16)) << 16) | (u16)EnvSat16((s16)a + (s16)b);
+}
+inline s32 EnvSmlabb(u32 a, u32 b, s32 acc) { return (s32)(u32)((u32)acc + (u32)((s32)(s16)a * (s32)(s16)b)); }
+inline s32 EnvSmlatt(u32 a, u32 b, s32 acc) { return (s32)(u32)((u32)acc + (u32)((s32)(s16)(a >> 16) * (s32)(s16)(b >> 16))); }
+#endif
+
+// The bytes each buffer covers for `count` bytes of samples: whole groups of
+// 8 samples, as the original loop runs them.
+inline u32 EnvMixer1Bytes(u32 count)		{ return (count + 0xF) & ~0xFu; }
+
+inline bool EnvMixer1FastApplies(const u32 * offsets, u32 n, u32 count)
+{
+	const u32 bytes = EnvMixer1Bytes(count);
+	for (u32 i = 0; i < n; ++i)
+	{
+		if (offsets[i] & 3)
+			return false;
+		for (u32 j = i + 1; j < n; ++j)
+		{
+			if (offsets[i] == offsets[j])
+				continue;
+			if (offsets[i] < offsets[j] + bytes && offsets[j] < offsets[i] + bytes)
+				return false;
+		}
+	}
+	return true;
+}
+
+// One ramp of the original loop: the per-sample accumulator step and the
+// gains it gives.
+struct EnvRamp1
+{
+	s32 Acc, Vol, Trg;
+	s32 * AdderStart;		// set to Trg when the ramp reaches it
+	s32 OMain, OAux;		// gains at the target
+
+	inline void Step(s32 dry, s32 wet, s32 & main, s32 & aux)
+	{
+		Acc += Vol;
+		if (Vol <= 0 ? Acc < Trg : Acc > Trg)
+		{
+			Acc = Trg;
+			*AdderStart = Trg;
+			main = OMain;
+			aux = OAux;
+		}
+		else
+		{
+			main = (dry * (Acc >> 16) + 0x4000) >> 15;
+			aux = (wet * (Acc >> 16) + 0x4000) >> 15;
+		}
+	}
+};
+
+template <bool kAux>
+inline void EnvMixer1Pair(u8 * buffer, u32 in, u32 out, u32 a1, u32 a2, u32 a3,
+						  const s32 * main_l, const s32 * main_r, const s32 * aux_l, const s32 * aux_r)
+{
+	// [0] = gains for the high halfword (processed first), [1] = low.  All
+	// words are read before any is written, as the original reads every
+	// buffer of an element before storing (buffers may be the same).
+	const u32 i = EnvLoad(buffer + in);
+	const s32 ih = (s16)(i >> 16), il = (s16)i;
+	const u32 o = EnvLoad(buffer + out), x1 = EnvLoad(buffer + a1);
+	const u32 x2 = kAux ? EnvLoad(buffer + a2) : 0, x3 = kAux ? EnvLoad(buffer + a3) : 0;
+	EnvStore(buffer + out, ((u32)(u16)EnvMix((s16)(o >> 16), ih, main_r[0]) << 16) | (u16)EnvMix((s16)o, il, main_r[1]));
+	EnvStore(buffer + a1, ((u32)(u16)EnvMix((s16)(x1 >> 16), ih, main_l[0]) << 16) | (u16)EnvMix((s16)x1, il, main_l[1]));
+	if (kAux)
+	{
+		EnvStore(buffer + a2, ((u32)(u16)EnvMix((s16)(x2 >> 16), ih, aux_r[0]) << 16) | (u16)EnvMix((s16)x2, il, aux_r[1]));
+		EnvStore(buffer + a3, ((u32)(u16)EnvMix((s16)(x3 >> 16), ih, aux_l[0]) << 16) | (u16)EnvMix((s16)x3, il, aux_l[1]));
+	}
+}
+
+// The same with SIMD instructions, for gains of at most 32767 in magnitude:
+// then (in * gain + 0x4000) >> 15 fits in 16 bits for any 16-bit input, so
+// saturating it into the buffer with QADD16 is exact.  Each gain word holds
+// the low element's gain in its low halfword and the high element's above.
+inline bool EnvGainFits(s32 gain)		{ return gain >= -32767 && gain <= 32767; }
+inline u32 EnvGainWord(const s32 * g)	{ return (u16)g[1] | ((u32)(u16)g[0] << 16); }
+inline u32 EnvGainPair(u32 in, u32 gains)
+{
+	const s32 lo = EnvSmlabb(in, gains, 0x4000) >> 15;
+	const s32 hi = EnvSmlatt(in, gains, 0x4000) >> 15;
+	return (u16)lo | ((u32)hi << 16);
+}
+
+template <bool kAux>
+inline void EnvMixer1PairSimd(u8 * buffer, u32 in, u32 out, u32 a1, u32 a2, u32 a3,
+							  u32 main_l, u32 main_r, u32 aux_l, u32 aux_r)
+{
+	const u32 i = EnvLoad(buffer + in);
+	const u32 o = EnvLoad(buffer + out), x1 = EnvLoad(buffer + a1);
+	const u32 x2 = kAux ? EnvLoad(buffer + a2) : 0, x3 = kAux ? EnvLoad(buffer + a3) : 0;
+	EnvStore(buffer + out, EnvQadd16(o, EnvGainPair(i, main_r)));
+	EnvStore(buffer + a1, EnvQadd16(x1, EnvGainPair(i, main_l)));
+	if (kAux)
+	{
+		EnvStore(buffer + a2, EnvQadd16(x2, EnvGainPair(i, aux_r)));
+		EnvStore(buffer + a3, EnvQadd16(x3, EnvGainPair(i, aux_l)));
+	}
+}
+
+// The `for (y = 0; y < Count; y += 0x10)` loop of AudioHLEState::EnvMixer.
+// Offsets are DMEM byte offsets into `buffer`; a2/a3 are used only with kAux.
+template <bool kAux>
+void EnvMixer1Fast(u8 * buffer, u32 in, u32 out, u32 a1, u32 a2, u32 a3, u32 count,
+				   s16 Wet, s16 Dry, s32 LTrg, s32 RTrg, s32 LRamp, s32 RRamp,
+				   s32 & LAdderStart, s32 & RAdderStart, s32 & LAdderEnd, s32 & RAdderEnd)
+{
+	const s32 oMainL = (Dry * (LTrg >> 16) + 0x4000) >> 15;
+	const s32 oAuxL = (Wet * (LTrg >> 16) + 0x4000) >> 15;
+	const s32 oMainR = (Dry * (RTrg >> 16) + 0x4000) >> 15;
+	const s32 oAuxR = (Wet * (RTrg >> 16) + 0x4000) >> 15;
+
+	for (u32 y = 0; y < count; y += 0x10)
+	{
+		EnvRamp1 l = { 0, 0, LTrg, &LAdderStart, oMainL, oAuxL };
+		EnvRamp1 r = { 0, 0, RTrg, &RAdderStart, oMainR, oAuxR };
+		if (LAdderStart != LTrg)
+		{
+			const u32 orig_ladder_end = LAdderEnd;
+			l.Acc = LAdderStart;
+			l.Vol = (LAdderEnd - LAdderStart) >> 3;
+			LAdderEnd = s32(((s64)LAdderEnd * (s64)LRamp) >> 16);
+			LAdderStart = orig_ladder_end;
+		}
+		else
+		{
+			l.Acc = LTrg;
+		}
+		if (RAdderStart != RTrg)
+		{
+			const u32 orig_radder_end = RAdderEnd;
+			r.Acc = RAdderStart;
+			r.Vol = (orig_radder_end - RAdderStart) >> 3;
+			RAdderEnd = s32(((s64)RAdderEnd * (s64)RRamp) >> 16);
+			RAdderStart = orig_radder_end;
+		}
+		else
+		{
+			r.Acc = RTrg;
+		}
+
+		const u32 group = y;	// byte offset of this group in every buffer
+		s32 main_l[8], main_r[8], aux_l[8], aux_r[8];
+		if (l.Vol == 0 && r.Vol == 0)
+		{
+			// Neither accumulator moves, so all 8 samples get the gains of
+			// the first one (its clamp side effect is the same each time).
+			l.Step(Dry, Wet, main_l[0], aux_l[0]);
+			r.Step(Dry, Wet, main_r[0], aux_r[0]);
+			const s32 ml[2] = { main_l[0], main_l[0] }, mr[2] = { main_r[0], main_r[0] };
+			const s32 al[2] = { aux_l[0], aux_l[0] }, ar[2] = { aux_r[0], aux_r[0] };
+			if (EnvGainFits(main_l[0]) && EnvGainFits(main_r[0]) && (!kAux || (EnvGainFits(aux_l[0]) && EnvGainFits(aux_r[0]))))
+			{
+				const u32 gml = EnvGainWord(ml), gmr = EnvGainWord(mr), gal = EnvGainWord(al), gar = EnvGainWord(ar);
+				for (u32 k = 0; k < 0x10; k += 4)
+					EnvMixer1PairSimd<kAux>(buffer, in + group + k, out + group + k, a1 + group + k, a2 + group + k, a3 + group + k,
+											gml, gmr, gal, gar);
+			}
+			else
+			{
+				for (u32 k = 0; k < 0x10; k += 4)
+					EnvMixer1Pair<kAux>(buffer, in + group + k, out + group + k, a1 + group + k, a2 + group + k, a3 + group + k, ml, mr, al, ar);
+			}
+		}
+		else
+		{
+			// Sample s of the group is element s ^ 1: high halfword first.
+			for (u32 s = 0; s < 8; ++s)
+			{
+				l.Step(Dry, Wet, main_l[s], aux_l[s]);
+				r.Step(Dry, Wet, main_r[s], aux_r[s]);
+			}
+			bool fits = true;
+			for (u32 s = 0; s < 8; ++s)
+				fits = fits && EnvGainFits(main_l[s]) && EnvGainFits(main_r[s]) &&
+					   (!kAux || (EnvGainFits(aux_l[s]) && EnvGainFits(aux_r[s])));
+			for (u32 k = 0; k < 4; ++k)
+			{
+				const u32 o = group + k * 4;
+				if (fits)
+					EnvMixer1PairSimd<kAux>(buffer, in + o, out + o, a1 + o, a2 + o, a3 + o,
+											EnvGainWord(main_l + 2 * k), EnvGainWord(main_r + 2 * k),
+											EnvGainWord(aux_l + 2 * k), EnvGainWord(aux_r + 2 * k));
+				else
+					EnvMixer1Pair<kAux>(buffer, in + o, out + o, a1 + o, a2 + o, a3 + o,
+										main_l + 2 * k, main_r + 2 * k, aux_l + 2 * k, aux_r + 2 * k);
+			}
+		}
+	}
+}
+
+// n64to3ds: the same treatment for ENVMIXER2 (ABI2).  Per element the
+// original reads the input, adds into bufft6, then bufft7, then buffs0 and
+// buffs1, each read just before it is written, so with buffers that are the
+// same a later read sees an earlier write; EnvMixer2FastApplies() therefore
+// asks for buffers that do not overlap at all.  The envelope values are
+// constant within a block, so the order of the elements does not matter.
+inline bool EnvMixer2FastApplies(const u32 * offsets, u32 n, u32 bytes)
+{
+	for (u32 i = 0; i < n; ++i)
+	{
+		if (offsets[i] & 3)
+			return false;
+		for (u32 j = i + 1; j < n; ++j)
+			if (offsets[i] < offsets[j] + bytes && offsets[j] < offsets[i] + bytes)
+				return false;
+	}
+	return true;
+}
+
+
+// (s16)(((u32)x * e) >> 16) of the original for both halfwords of `pair`,
+// repacked, then XORed with `mask` (the low 16 bits of v2[] of the original
+// in both halfwords).  e < 0x10000, so the 48-bit product's bits 31..16 are the
+// same as those of the original's 32-bit product.
+inline u32 EnvScale2(u32 pair, u32 e, u32 mask)
+{
+	return (((u32)EnvSmulwt((s32)e, pair) << 16) | (u16)EnvSmulwb((s32)e, pair)) ^ mask;
+}
+
+struct EnvMixer2Gains
+{
+	u32 e0, e2, e4;					// env[0], env[2], env[4] (or env[1], [3], [5])
+	u32 m0, m1, m2, m3;				// v2[0..3] of the original, low 16 bits in both halfwords
+};
+
+// Words at the same offset of the five buffers, 2 elements each.  The
+// buffers do not overlap (EnvMixer2FastApplies), so each word can be read
+// and written on its own.
+template <bool kSwap>
+inline void EnvMixer2Pair(u8 * s3, u8 * t6, u8 * t7, u8 * s0, u8 * s1, const EnvMixer2Gains & g)
+{
+	const u32 in = EnvLoad(s3);
+	const u32 vec9 = EnvScale2(in, g.e0, g.m0);
+	const u32 vec10 = EnvScale2(in, g.e2, g.m1);
+	EnvStore(t6, EnvQadd16(EnvLoad(t6), vec9));
+	EnvStore(t7, EnvQadd16(EnvLoad(t7), vec10));
+	const u32 vec9b = EnvScale2(vec9, g.e4, g.m2);
+	const u32 vec10b = EnvScale2(vec10, g.e4, g.m3);
+	EnvStore(s0, EnvQadd16(EnvLoad(s0), kSwap ? vec10b : vec9b));
+	EnvStore(s1, EnvQadd16(EnvLoad(s1), kSwap ? vec9b : vec10b));
+}
+
+// The `while (count > 0)` loop of ENVMIXER2.  `buffers` are s3, t6, t7, s0,
+// s1; `block` is 16 elements (8 for the Mario Kart ABI), of which the first
+// 8 use env[0], env[2], env[4] and the next 8 env[1], env[3], env[5].
+template <bool kSwap>
+void EnvMixer2Fast(u8 * const * buffers, s32 count, u32 block, u16 * env, const s16 * v2,
+				   u32 s5, u32 s6, u32 t3)
+{
+	u8 * s3 = buffers[0], * t6 = buffers[1], * t7 = buffers[2], * s0 = buffers[3], * s1 = buffers[4];
+	while (count > 0)
+	{
+		for (u32 half = 0; half * 8 < block; ++half)
+		{
+			// v2[] is 0, -1, -2 or -4: the XOR masks repeat its low 16 bits.
+			const EnvMixer2Gains g = { env[0 + half], env[2 + half], env[4 + half],
+									   (u16)v2[0] * 0x10001u, (u16)v2[1] * 0x10001u,
+									   (u16)v2[2] * 0x10001u, (u16)v2[3] * 0x10001u };
+			for (u32 k = half * 16; k < half * 16 + 16; k += 4)
+				EnvMixer2Pair<kSwap>(s3 + k, t6 + k, t7 + k, s0 + k, s1 + k, g);
+		}
+		const u32 bytes = block * 2;
+		s3 += bytes; t6 += bytes; t7 += bytes; s0 += bytes; s1 += bytes;
+		count -= block;
+		env[0] = (u16)(env[0] + s5);
+		env[1] = (u16)(env[1] + s5);
+		env[2] = (u16)(env[2] + s6);
+		env[3] = (u16)(env[3] + s6);
+		env[4] = (u16)(env[4] + t3);
+		env[5] = (u16)(env[5] + t3);
+	}
+}
+
+}	// namespace n64to3ds_audio
