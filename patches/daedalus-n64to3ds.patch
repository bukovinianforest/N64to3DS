+// n64to3ds: AI DMA FIFO model.
+//
+// Upstream Daedalus returned the last written AI_LEN forever.  libultra's
+// audio code reads AI_LEN to see how much of the current buffer is still
+// playing and generates only the missing samples, so a length that never
+// counts down made games produce too little audio (HM64: about 14% short,
+// heard as choppy sound).  Real hardware has a two-entry DMA FIFO: AI_LEN
+// reads the bytes left in the playing buffer, and AI_STATUS reports BUSY and
+// FULL.  Playback is advanced from the CP0 Count register (46.875 MHz on
+// hardware) at the rate set in AI_DACRATE.
+namespace
+{
+	constexpr u64 kAICountHz = 46875000;
+	// n64to3ds: the hardware FIFO holds the playing buffer and one more.  The
+	// model queues up to kAIQueueDepth: an AI_LEN write copies the samples
+	// into the output ring at once (CAudioPluginCTR::LenChanged), so the guest
+	// may reuse its buffers early, and the deeper queue lets NuSys's audio
+	// manager, which makes no audio for a retrace that finds the FIFO FULL,
+	// catch up after its audio task waited for a graphics task on core 1
+	// (console: 80-165 skipped frames/min at the hardware depth and the
+	// output ring at its floor whatever the VI rate).
+	constexpr u32 kAIQueueDepth = 3;
+	u32 gAICurrentBytes = 0;	// bytes left in the playing buffer
+	u32 gAIQueue[kAIQueueDepth] = {};	// queued buffers, oldest first
+	u32 gAIQueued = 0;
+
+	u32 AI_PopQueue()
+	{
+		if (gAIQueued == 0)
+			return 0;
+		const u32 next = gAIQueue[0];
+		for (u32 i = 1; i < gAIQueued; ++i)
+			gAIQueue[i - 1] = gAIQueue[i];
+		--gAIQueued;
+		return next;
+	}
+	u32 gAILastCount = 0;
+	u64 gAIFraction = 0;		// sub-byte remainder, in byte * kAICountHz units
+
+	void AI_AdvanceModel()
+	{
+		const u32 now = gCPUState.CPUControl[C0_COUNT]._u32;
+		const u32 elapsed = now - gAILastCount;
+		gAILastCount = now;
+		if (gAICurrentBytes == 0)
+		{
+			gAIFraction = 0;
+			return;
+		}
+
+		const u32 dacrate = *(u32 *)((u8 *)g_pMemoryBuffers[MEM_AI_REG] + 0x10) & 0x3FFF;
+		const u64 clock = g_ROM.TvType ? VI_NTSC_CLOCK : VI_PAL_CLOCK;
+		const u64 bytes_per_second = (clock / (dacrate + 1)) * 4;	// 16-bit stereo
+#ifdef DAEDALUS_CTR
+		// n64to3ds: under real-time VI pacing one VI is one TV frame of audio.
+		const u64 count_hz = CPU_GetAICountHz(kAICountHz);
+#else
+		const u64 count_hz = kAICountHz;
+#endif
+		gAIFraction += u64(elapsed) * bytes_per_second;
+		u64 consumed = gAIFraction / count_hz;
+		gAIFraction %= count_hz;
+
+		while (consumed != 0 && gAICurrentBytes != 0)
+		{
+			if (consumed < gAICurrentBytes)
+			{
+				gAICurrentBytes -= u32(consumed);
+				consumed = 0;
+			}
+			else
+			{
+				consumed -= gAICurrentBytes;
+				gAICurrentBytes = AI_PopQueue();
+			}
+		}
+		if (gAICurrentBytes == 0)
+			gAIFraction = 0;
+	}
+}
+
+// n64to3ds: AI_LEN writes and the samples they carried, for the periodic log
+// line (SysCTR/main.cpp).
+u32 gAILenWrites = 0;
+u32 gAILenSamples = 0;
+
+void AI_ResetModel()
+{
+	gAICurrentBytes = 0;
+	gAIQueued = 0;
+	gAILastCount = gCPUState.CPUControl[C0_COUNT]._u32;
+	gAIFraction = 0;
+}
+
+void AI_QueueBuffer(u32 length)
+{
+	AI_AdvanceModel();
+	length &= 0x3FFF8;	// LS 3 bits ignored, 18-bit length
+	if (length == 0)
+		return;
+	++gAILenWrites;
+	gAILenSamples += length / 4;
+	if (gAICurrentBytes == 0)
+		gAICurrentBytes = length;
+	else if (gAIQueued < kAIQueueDepth)
+		gAIQueue[gAIQueued++] = length;
+	else
+		gAIQueue[kAIQueueDepth - 1] = length;	// a write while FULL replaces the last entry
+}
+
+// n64to3ds: AI_STATUS reads that showed the FIFO full, for the periodic log
+// line (SysCTR/main.cpp).  NuSys's audio manager reads the status once per
+// retrace and makes no audio for that frame when the FIFO is full.
+u32 gAIStatusFullReads = 0;
+
 // 0x0450 0000 to 0x045F FFFF Audio Interface (AI) Registers
 static const void * Read_8450_845F( u32 address )
 {
 	#ifdef DAEDALUS_DEBUG_CONSOLE
 	DPF( DEBUG_MEMORY_AI, "Reading from AI Registers: 0x%08x", address );
 	#endif
-	return (u8 *)g_pMemoryBuffers[MEM_AI_REG] + (address & 0xFF);
+	const u32 offset = address & 0xFF;
+	if (offset == 0x4 || offset == 0xC)
+	{
+		AI_AdvanceModel();
+		static u32 value;
+		if (offset == 0x4)
+			value = gAICurrentBytes;
+		else
+		{
+			const bool full = gAIQueued == kAIQueueDepth;
+			value = (full ? 0x80000000u : 0u) | (gAICurrentBytes != 0 ? 0x40000000u : 0u);
+			if (full)
+				++gAIStatusFullReads;
+		}
+		return &value;
+	}
+	return (u8 *)g_pMemoryBuffers[MEM_AI_REG] + offset;
 }
 
